\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ffvstil}[2026/09/02 v1.3 Artikkelstil — tokolonne]

% ============================================================
% ffvstil.sty — en tokolonnes artikkel
%
% Til essayistiske artikler i teoretisk fysikk og
% matematikk. Alt om hvordan artikkelen ser ut settes her;
% main.tex inneholder bare innholdet.
%
% Motor: LuaLaTeX. Fontene er OpenType og lastes gjennom
% unicode-math, og det kan ikke pdflatex.
%
% Rekkefølgen nedenfor: språk, fonter, geometri, avstander,
% seksjonering, flyt, sidemøblering, natbib, hyperref sist.
% ============================================================


% ============================================================
% SPRÅK
%
% babel lastes her og ikke i main.tex, slik at det å laste
% stilen er nok til å få orddeling og tegnsetting riktig.
% Bytt språk på linja under.
% ============================================================
\RequirePackage[norsk]{babel}


% ============================================================
% TALL OG ENHETER (siunitx)
%
% main.tex laster siunitx når et dokument trenger \qty og
% \num; stilen bærer språkvalgene, så et dokument som laster
% pakka får norsk sats uten å sette opp noe selv. Kroken
% kjører i det øyeblikket siunitx lastes -- før resten av
% preamble -- så en \sisetup i main.tex overstyrer fortsatt
% det som står her. Gjør ingenting i et dokument som aldri
% laster siunitx.
%
% Valgene følger Språkrådet og NS-ISO 80000-1:
%   desimalkomma          6,63 -- ikke 6.63
%   halvhøy prikk         6,63 · 10^-34 -- ikke kryss; ISO
%                         forbeholder krysset for
%                         desimalpunktum-tradisjonen
%   «til» og «og»         \qtyrange: 10 km til 20 km,
%                         \qtylist: 1 V, 2 V og 3 V
%   skråstrek i enheter   m/s^2 -- ikke m s^-2; lærebok,
%                         ikke tidsskrift
%   samlet usikkerhet     (9,81 ± 0,03) m/s^2
%
% Resten er siunitx sine standarder og skal stå: tynt
% mellomrom rundt gangetegnet og mellom tall og enhet (som
% hos Griffiths), tusenskille med tynt mellomrom fra fem
% sifre (10 000, men 1000), og mellomrom foran %.
% ============================================================
\AddToHook{package/siunitx/after}{%
  \sisetup{
    output-decimal-marker = {,},
    exponent-product      = \cdot,
    range-phrase          = { til },
    list-final-separator  = { og },
    list-pair-separator   = { og },
    per-mode              = symbol,
    separate-uncertainty  = true,
  }%
}


% ============================================================
% FONTER OG MIKROTYPOGRAFI
%
% STIX Two hele veien, tekst og matematikk fra samme
% familie — en Times-lignende skrift med en komplett
% matteledsager, og det er dét som hindrer at symboler i
% løpende tekst skiller seg ut fra prosaen.
%
% Fet matematikk er \symbf, \symbfit, \symbfup. De henter
% STIX Two sine tegnede fete Unicode-alfabeter fra samme
% fil, og virker derfor på gresk så vel som latinsk. \bm og
% \boldmath hører pdflatex-tida til og virker ikke her — se
% README.
%
% protrusion henger tegnsetting ut i margen, expansion
% strekker glyffene brøkdeler av en prosent for å unngå løse
% linjer — begge gjør nytte for seg i smale spalter.
% ============================================================
\RequirePackage{unicode-math}

\setmainfont{STIXTwoText}[
  Extension      = .otf,
  UprightFont    = *-Regular,
  ItalicFont     = *-Italic,
  BoldFont       = *-Bold,
  BoldItalicFont = *-BoldItalic ]

\setmathfont{STIXTwoMath-Regular.otf}

\RequirePackage[
  expansion=true,
  protrusion=true,
  tracking=true
]{microtype}


% ============================================================
% SIDEGEOMETRI (A4, TOKOLONNE)
%
% 2 cm marger og 7 mm spaltemellomrom gir to spalter på
% 81,5 mm. Det er en kort satsbredde med vilje: en smal
% spalte trenger mindre kjegle og tåler mer orddeling enn en
% side i full bredde, og det er dét tokolonneformatet kjøper
% deg.
% ============================================================
\RequirePackage[
  a4paper,
  left=2.0cm,
  right=2.0cm,
  top=2.5cm,
  bottom=2.7cm,
  columnsep=0.7cm
]{geometry}


% ============================================================
% AVSNITT OG KJEGLE
%
% STIX Two ved 10pt har en naturlig grunnlinje på 12pt.
% \setstretch{1.05} tar den til rundt 12,6 pt — nok til at
% matematikk i løpende tekst får plass i spalta uten å
% skyve prosaen fra hverandre.
%
% Innrykkede avsnitt, ingen luft mellom dem.
% ============================================================
\setlength{\parindent}{12pt}
\setlength{\parskip}{0pt}

\RequirePackage{setspace}
\setstretch{1.05}


% ============================================================
% AVSTAND RUNDT VISTE LIGNINGER
%
% Stemt mot grunnlinjen på 12,6 pt, så vist matematikk
% holder rytmen i spalta.
%
%   over   10pt     etter en kort innledende linje   4pt
%   under  10pt     alltid                          10pt
%
% 10pt er litt under én grunnlinje: nok til at ligningen
% puster uten å løsrive seg fra setningen sin. Bare
% avstanden over krymper etter en kort linje, siden en kort
% linje allerede gir luft av seg selv. Avstanden under er
% alltid full, så luften under en ligning avhenger aldri av
% hva som kom før.
%
% \AtBeginDocument er ikke pynt. \begin{document} kjører
% \normalsize, som nullstiller alle fire skipene til
% klassens standard, så verdier satt i preamblet blir stille
% forkastet.
% ============================================================
\AtBeginDocument{%
  \setlength{\abovedisplayskip}{10pt plus 3pt minus 2pt}%
  \setlength{\belowdisplayskip}{10pt plus 3pt minus 2pt}%
  \setlength{\abovedisplayshortskip}{4pt plus 2pt minus 1pt}%
  \setlength{\belowdisplayshortskip}{10pt plus 3pt minus 2pt}%
}


% ============================================================
% SEKSJONERING
%
% To nivåer, begge fete og oppreiste, og nummererte. En smal
% spalte har ikke plass til displaystørrelser, så hierarkiet
% bæres av ett steg ned fra kroppsstørrelse på underseksjonen
% og av luften over hver overskrift.
% ============================================================
\RequirePackage{titlesec}

% Seksjoner: fete, litt større
\titleformat{\section}
  {\normalfont\normalsize\bfseries}
  {\thesection.}{0.6em}{}

\titlespacing*{\section}
  {0pt}{3.5ex plus 1.0ex minus .4ex}{1.6ex plus .3ex}

% Underseksjoner: fete, samme størrelse som brødtekst
\titleformat{\subsection}
  {\normalfont\small\bfseries}
  {\thesubsection.}{0.6em}{}

\titlespacing*{\subsection}
  {0pt}{3.0ex plus 0.8ex minus .3ex}{1.2ex plus .3ex}


% ============================================================
% FLYTPARAMETERE
%
% LaTeX sine standardverdier er forsiktige nok til at en
% tokolonneartikkel ofte ender med halvtomme sider. Disse
% lar en figur ta mer av siden før LaTeX gir opp og utsetter
% den.
%
%   topfraction         mest floats kan ta av en sidetopp
%   bottomfraction      mest de kan ta av en sidebunn
%   textfraction        minst tekst en blandet side må ha
%   floatpagefraction   minst en ren float-side må fylle
%
% dbl*-variantene er de samme grensene for figure*, som
% spenner over begge spaltene.
% ============================================================
\renewcommand{\topfraction}{0.90}
\renewcommand{\bottomfraction}{0.80}
\renewcommand{\textfraction}{0.10}
\renewcommand{\floatpagefraction}{0.75}
\renewcommand{\dbltopfraction}{0.90}       % for figure* (tokolonne)
\renewcommand{\dblfloatpagefraction}{0.75}

% Avstand mellom flere figurer og mellom figurer og tekst
\setlength{\textfloatsep}{14pt plus 3pt minus 3pt}
\setlength{\floatsep}{12pt plus 3pt minus 2pt}
\setlength{\intextsep}{12pt plus 3pt minus 2pt}
\setlength{\dbltextfloatsep}{14pt plus 3pt minus 3pt}
\setlength{\dblfloatsep}{12pt plus 3pt minus 2pt}


% ============================================================
% FIGURTEKSTER
%
%   font=small       ett steg under kroppsteksten
%   labelfont=bf     fet «Figur 1.»-etikett
%   labelsep=period  punktum etter nummeret, ikke kolon
%   skip=6pt         tettere luft, tilpasset den smale spalta
%
% Figurtekster på én linje sentrerer seg selv; lengre tekst
% blir justert.
% ============================================================
\RequirePackage[
  font=small,
  labelfont=bf,
  labelsep=period,
  singlelinecheck=true,
  skip=6pt
]{caption}


% ============================================================
% TABELLER
%
% booktabs: \toprule, \midrule, \bottomrule, og ingen
% vertikale streker i det hele tatt. arraystretch åpner
% radene 15 %, som en tabell uten vertikale streker trenger
% for å holde seg lesbar.
% ============================================================
\RequirePackage{booktabs}
\renewcommand{\arraystretch}{1.15}


% ============================================================
% GRAFIKK
%
% \includegraphics. main.tex setter \graphicspath om
% figurene ligger i en egen mappe.
% ============================================================
\RequirePackage{graphicx}


% ============================================================
% SIDESTIL
%
% Ingen løpende topptekst; sidetallet sentrert nederst.
% ============================================================
\pagestyle{plain}


% ============================================================
% TITTELBLOKK
%
%   \twocolumn[\maketitle \begin{ingress} ... \end{ingress}]
%
% Tittelen spenner over hele sidebredden over spaltene, og
% det er dét \twocolumn[...]-argumentet er til for. Tittel i
% kapiteler, forfatter og dato under.
% ============================================================
\makeatletter
\renewcommand{\maketitle}{%
  \thispagestyle{plain}
  \begin{center}
    {\large\scshape \@title \par}
    \vspace{1.4em}
    {\normalsize \@author \par}
    \vspace{0.4em}
    {\small \@date \par}
  \end{center}
  \vspace{1.6em}
}
\makeatother


% ============================================================
% INGRESS
%
%   \begin{ingress} ... \end{ingress}
%
% Et fett innledningsavsnitt over hele sidebredden, satt til
% 92 % av satsbredden så det leses som en blokk og ikke som
% et første avsnitt. Plasseres rett etter \maketitle, inne i
% det samme \twocolumn[...]-argumentet.
% ============================================================
\newenvironment{ingress}{%
  \par
  \centering
  \begin{minipage}{0.92\linewidth}
    \small\bfseries
    \setstretch{1.05}
}{%
  \end{minipage}
  \par
  \vspace{1.8em}
}


% ============================================================
% SITERINGER
%
%   \cite{nokkel}         [1]
%   \cite{a,b,c}          sortert og komprimert, [1-3]
%   \bibliographystyle{unsrtnat}   i main.tex
%
% natbib må lastes før hyperref.
% ============================================================
\RequirePackage[numbers,sort&compress]{natbib}


% ============================================================
% HYPERLENKER
%
% Lastes sist, fordi hyperref patcher kommandoer andre
% pakker definerer. Mørkerød i stedet for standardblå: den
% holder seg lesbar når artikkelen trykkes i gråtoner.
% ============================================================
\RequirePackage{xcolor}
\definecolor{darkred}{RGB}{120,20,20}

\RequirePackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=darkred,
  citecolor=darkred,
  urlcolor=darkred,
  linktoc=page
}


% ============================================================
% SLUTT PÅ FIL
% ============================================================
\endinput
