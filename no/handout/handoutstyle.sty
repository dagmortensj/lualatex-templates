\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{handoutstyle}[2026/08/26 v1.3 Handout-stil — rolig klassisk typografi for oppgavesett]

% ============================================================
% FILOSOFI
%
% Denne stilen er for fysikk- / matematikknotater og
% oppgavesett (ikke artikler eller monografier).
%
% Typografisk hører den til samme familie som notat- og
% bokstilen — rolig og klassisk — men lettere:
% stille overskrifter, romslige marger, og ingen
% innholdsfortegnelse eller bibliografi som standard.
%
% Designprinsipper:
%  - konservativ typografi
%  - forutsigbar avstand
%  - minimale redefinisjoner
%  - ingen skjøre liste-triks
%
% Når du er i tvil, foretrekk stabilitet framfor lurerier.
% ============================================================


% ============================================================
% FONT & MIKROTYPOGRAFI
% ============================================================
% MOTOR: LuaLaTeX (ikke pdflatex).
%
% NewComputerModern beholder det velkjente TeX-uttrykket
% uten Latin Moderns tynnhet. Pakka har Book-vekta som
% standard; [regular] gir den gamle, tynnere CM-vekta.
%
% Fet matematikk er \symbf / \symbfit / \symbfup. \bm og
% \boldmath hører pdflatex-tida til og virker ikke her
% -- se README.
\RequirePackage{newcomputermodern}

\RequirePackage[
  expansion=true,
  protrusion=true,
  tracking=true
]{microtype}


% ============================================================
% SIDEGEOMETRI
% ============================================================
%
% A4-oppsett med romslige marger.
% Optimalisert for utskrift og annotering.
%
\RequirePackage[
  a4paper,
  left=3.0cm,
  right=3.0cm,
  top=2.6cm,
  bottom=3.0cm
]{geometry}


% ============================================================
% AVSNITT & LINJEAVSTAND
% ============================================================
%
% Klassiske boklige avsnitt:
%  - innrykk
%  - ingen vertikal avsnittsavstand
%
\setlength{\parindent}{15pt}
\setlength{\parskip}{0pt}

% Litt slakkere linjeavstand for lesbarhet
\RequirePackage{setspace}
\setstretch{1.04}


% ============================================================
% AVSTAND VED FRAMHEVEDE LIGNINGER
% ============================================================
%
% Litt luft rundt framhevede ligninger, ett hakk strammere enn
% book-/notes-stilene for å passe kortere dokumenter. Bare OVER-
% skipet krymper etter en kort innledende linje (en kort linje gir
% allerede luft der), og aldri til null; UNDER-skipet er alltid
% full verdi, så luften under en ligning aldri avhenger av hva som
% stod over:
%     over 10pt    over (etter kort linje)   6pt
%     under 10pt   under (alltid)           10pt
%
% Settes via \AtBeginDocument: LaTeX sin \normalsize (kjørt av
% \begin{document}) nullstiller alle fire display-skip til
% klassens standard (der \abovedisplayshortskip er 0pt), så
% verdier satt i preamblet ville blitt stille overstyrt. Ved å
% sette dem etter \normalsize trer de i kraft.
%
\AtBeginDocument{%
  \setlength{\abovedisplayskip}{10pt plus 3pt minus 2pt}%
  \setlength{\belowdisplayskip}{10pt plus 3pt minus 2pt}%
  \setlength{\abovedisplayshortskip}{6pt plus 2pt minus 2pt}%
  \setlength{\belowdisplayshortskip}{10pt plus 3pt minus 2pt}%
}


% ============================================================
% FIGURTEKSTER
%
% font=small      -- ett steg under kroppstekst (JHEP/CUP-standard)
% labelfont=bf    -- fet «Figur 1.»-etikett (JHEP/CUP-standard)
% labelsep=period -- punktum etter nummeret, ikke kolon (JHEP-stil)
% justification: default (singlelinecheck=true) -- enkeltlinjer
%   sentreres automatisk; flerlinjers tekst justeres
% ============================================================
\RequirePackage[font=small,labelfont=bf,labelsep=period]{caption}


% ============================================================
% SEKSJONSOVERSKRIFTER
% ============================================================
%
% Overskrifter er bevisst stille:
%  - ingen overdimensjonerte fonter
%  - ingen dekorative streker
%
% To nivåer, slik at handout-en også kan brukes som
% forelesningsnotater. Begge holder seg på eller over
% kroppsstørrelse; hierarkiet bæres av ett størrelsessteg,
% ikke av store displayfonter:
%   seksjon     \large       (ett steg over kroppstekst)
%   underseksjon \normalsize  (lik kroppstekst)
%
\RequirePackage{titlesec}

% Seksjoner
\titleformat{\section}
  {\normalfont\large\bfseries}
  {\thesection}{0.6em}{}

\titlespacing*{\section}
  {0pt}
  {6ex plus 2ex minus .8ex}
  {2ex plus .5ex}

% Underseksjoner: mindre enn seksjoner, men ikke under kroppsstørrelse
\titleformat{\subsection}
  {\normalfont\normalsize\bfseries}
  {\thesubsection}{0.6em}{}

\titlespacing*{\subsection}
  {0pt}
  {3.5ex plus 1ex minus .5ex}
  {1.2ex plus .3ex}


% ============================================================
% SIDESTIL
% ============================================================
%
% Enkle sider: ingen topptekst, sentrert sidetall.
%
\pagestyle{plain}


% ============================================================
% TITTELBLOKK
% ============================================================
%
% Enkelt, rolig titteloppsett.
% Bruker \maketitle for robusthet.
%
\makeatletter
\renewcommand{\maketitle}{%
  \thispagestyle{plain}
  \begin{center}
    \vspace*{1em}
    {\Large\normalfont\scshape\lsstyle \@title\par}
    \vspace{1.6em}
    {\footnotesize\normalfont\scshape \@date\par}
    \vspace{3em}
  \end{center}
}
\makeatother


% ============================================================
% FARGER
% ============================================================
%
% Trefargerspalett for figurer: darkred / darkorange / darkolive.
%   darkred    -- fotnotelinje, strukturaksenter
%   darkorange -- figuraksent: streker, noder, fyllte områder (TikZ)
%   darkolive  -- figuraksent: andrefarge for kurver og fyll
%
\RequirePackage{xcolor}
\definecolor{darkred}   {RGB}{120, 20,  20}
\definecolor{darkorange}{RGB}{184, 92,   0}
\definecolor{darkolive} {RGB}{ 74,107,  18}


% ============================================================
% TEOREMOMGIVELSER
% ============================================================
%
% Standard strukturerte omgivelser for matematiske handouts:
%   teorem       nummerert per seksjon (Teorem 1.1, ...)
%   definisjon   deler teller med teorem
%   merknad      deler teller med teorem
%
% amsthm ligger også til grunn for oppgaveomgivelsen nedenfor,
% så den lastes én gang her. Etikettene er på norsk; bevis-
% etiketten settes også her.
%
\RequirePackage{amsthm}

% --- Luft rundt teorem-omgivelsene ---
% amsthm setter avstanden over/under disse omgivelsene gjennom
% hooken \thm@space@setup (standard: \topsep, en ganske stram
% gummilengde). Vi hever den til en romsligere, utjevnet verdi slik
% at teoremer, definisjoner og merknader leses som tydelige blokker
% i stedet for å trenge seg mot teksten rundt. Bare den vertikale
% avstanden røres — fonter, hode og innrykk forblir nøyaktig som
% amsthm definerer dem.
%
% amsthms 'remark'-stil halverer i tillegg den arvede avstanden;
% \th@remark settes på nytt for å droppe kun den halveringen (den
% kursiverte hodefonten og den oppreiste brødfonten beholdes), slik
% at merknader får samme avstand som teoremer og definisjoner.
\makeatletter
\def\thm@space@setup{%
  \setlength\thm@preskip{2.8ex plus 1ex minus .4ex}%
  \setlength\thm@postskip{\thm@preskip}%
}
\def\th@remark{\thm@headfont{\itshape}\normalfont}
\makeatother

\theoremstyle{plain}
\newtheorem{teorem}{Teorem}[section]

\theoremstyle{definition}
\newtheorem{definisjon}[teorem]{Definisjon}

\theoremstyle{remark}
\newtheorem{merknad}[teorem]{Merknad}

\renewcommand{\proofname}{Bevis}


% ============================================================
% SEPARATORLINJE
% ============================================================
%
% En linje med samme bredde som fotnotelinjen, satt i
% mørkerød. Bruk mellom innholdsblokker (etter oppgaver,
% mellom eksempler, temaskifter innen en seksjon, ...).
% Et visuelt signal som ikke konkurrerer med overskriftene.
%
% \let\orig@footnoterule\footnoterule
%   Lagrer den opprinnelige fotnotelinjen før en senere
%   pakke kan redefinere \footnoterule, så vi kan gjenbruke
%   bredden her uansett.
%
% Den innledende \par lukker et åpent avsnitt, så \separator
% er trygg å kalle rett etter løpende tekst.
%
\makeatletter
\let\orig@footnoterule\footnoterule
\newcommand{\separator}{%
  \par
  \vspace{3.5ex plus 1.5ex minus .5ex}
  {\color{darkred}\orig@footnoterule}
  \vspace{1.2ex}
}
\makeatother


% ============================================================
% OPPGAVEOMGIVELSE
% ============================================================
%
% Oppgaver er implementert med amsthm (lastet ovenfor):
%  - nummerert per seksjon (Oppgave 2.1, 2.2, ...)
%  - valgfri tittel: \begin{oppgave}[Tittel] gir
%    "Oppgave 1.1 - Tittel" med tittelen i fet
%  - lett innrykket via en quote-omgivelse
%
\newtheoremstyle{handoutex}
  {1ex}              % avstand over
  {1ex}              % avstand under
  {\normalfont}      % kroppsfont
  {0pt}              % innrykk
  {\bfseries}        % hodefont
  {}                 % hodetegnsetting
  {\newline}         % avstand mellom hode og kropp
  {\thmname{#1}\thmnumber{ #2}\thmnote{ - \bfseries#3}}

\theoremstyle{handoutex}
\newtheorem{oppgaveinner}{Oppgave}[section]
\renewcommand{\theoppgaveinner}{\thesection.\arabic{oppgaveinner}}

% Gjenopprett amsthms vanlige standard, så en eventuell
% teoremomgivelse lagt til senere (i main.tex) starter fra
% \theoremstyle{plain} i stedet for oppgavestilen.
\theoremstyle{plain}

% amsthm-stilen setter kroppen på en ny linje etter den fete
% etiketten ({\newline}-skillet over). \leavevmode\par\vspace{-2ex}
% trekker så kroppen opp til et tett mellomrom under etiketten.
% -2ex er font-relativ, så den følger linjehøyden på tvers av
% størrelser.
%
% Støtter valgfri tittel: \begin{oppgave}[Tittel]
% gir "Oppgave 1.1 - Tittel" med tittelen i fet.
\newenvironment{oppgave}[1][]
{%
  \par
  \begin{quote}
  \def\tmp{#1}\ifx\tmp\empty
    \begin{oppgaveinner}\leavevmode\par\vspace{-2ex}
  \else
    \begin{oppgaveinner}[#1]\leavevmode\par\vspace{-2ex}
  \fi
}
{%
  \end{oppgaveinner}
  \end{quote}
  \vspace{3.5ex plus 1.5ex minus .8ex}
}


% ============================================================
% DELOPPGAVER (a), b), c))
% ============================================================
%
% Deloppgaver bruker en egen 'deloppgaver'-liste i stedet for
% å redefinere enumerate, så vanlige nummererte lister fortsatt
% er tilgjengelige til vanlig bruk.
%
% Forklarende tekst mellom deloppgaver skrives som vanlig tekst
% utenfor omgivelsen; nummereringen gjenopptas så med
% \begin{deloppgaver}[resume].
%
\RequirePackage{enumitem}

% \newlist{<navn>}{<type>}{<maks dybde>}
% Definerer 'deloppgaver' som en enumerate-type liste, ett nivå.
\newlist{deloppgaver}{enumerate}{1}

\setlist[deloppgaver]{%
  label=\alph*),
  leftmargin=2.2em,
  labelsep=0.6em,
  itemsep=0.8ex,
  parsep=0.8ex,
  topsep=0.8ex
}


% ============================================================
% KODEEKSEMPLER
% ============================================================
%
% Python-kodeblokker med Gruvbox Light syntaksutheving via
% listings-pakken. Krever ingen shell-escape eller eksterne
% verktøy; alt er selvforsynt.
%
% Gruvbox Light Hard-palett (gruvbox.dayle.io):
%   bakgrunn    #fdfcf2   forgrunn    #3c3836
%   nøkkelord   #9d0006   strenger    #79740e
%   kommentarer #928374   tall        #b57614
%   innebygde   #076678
%
% Bruk:
%   \begin{python}
%     def f(x):
%         return x**2
%   \end{python}
%
\RequirePackage{listings}

\definecolor{gruvbg}    {HTML}{fdfcf2}
\definecolor{gruvfg}    {HTML}{3c3836}
\definecolor{gruvkw}    {HTML}{9d0006}
\definecolor{gruvstr}   {HTML}{79740e}
\definecolor{gruvcom}   {HTML}{928374}
\definecolor{gruvnum}   {HTML}{b57614}
\definecolor{gruvbi}    {HTML}{076678}

\lstdefinestyle{gruvboxlight}{
  backgroundcolor   = \color{gruvbg},
  basicstyle        = \small\ttfamily\color{gruvfg},
  keywordstyle      = \color{gruvkw}\bfseries,
  stringstyle       = \color{gruvstr},
  commentstyle      = \color{gruvcom}\itshape,
  numberstyle       = \color{gruvnum},
  identifierstyle   = \color{gruvfg},
  breaklines        = true,
  showstringspaces  = false,
  numbers           = left,
  numbersep         = 10pt,
  frame             = tb,
  xleftmargin       = 2em,
  xrightmargin      = 0em,
  framexleftmargin  = 2em,
  framexrightmargin = 0em,
  aboveskip         = 2.4ex,
  belowskip         = 2.4ex,
  extendedchars     = true,
  inputencoding     = utf8,
  literate          =
    {æ}{{\ae}}1 {ø}{{\o}}1 {å}{{\aa}}1
    {Æ}{{\AE}}1 {Ø}{{\O}}1 {Å}{{\AA}}1
}

\lstnewenvironment{python}
  {\lstset{language=Python, style=gruvboxlight,
           morekeywords={True,False,None,self}}}
  {}


% ============================================================
% HYPERLENKER
% ============================================================
%
% Lastet til slutt. Mørkerøde lenker, egnet for trykk.
%
\RequirePackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=darkred,
  citecolor=darkred,
  urlcolor=darkred
}

