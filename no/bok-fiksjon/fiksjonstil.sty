\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{fiksjonstil}[2026/11/14 v1.1 — roman, noveller og kortprosa]

% ============================================================
% PAKKEOPSJONER
%
%   \usepackage{fiksjonstil}              128 x 204 mm, trykk
%   \usepackage[hefte]{fiksjonstil}       blanke sider til
%                                         slutt, så heftet får
%                                         bakside
%   \usepackage[korrektur]{fiksjonstil}   sidekorrektur: siden
%                                         uendret, sentrert på
%                                         A4 med skjæremerker
%
% hefte — for en kort tekst som skrives ut som falset hefte:
% sidetallet fylles opp til et multiplum av fire med blanke
% sider til slutt, og den siste er baksiden. Sidene får
% plass uskalert på hver A5-halvdel av et A4-ark.
%
% korrektur — gir samme linje- og sidebrudd som trykk, med
% luft rundt siden til merknader. 'proof' godtas som
% synonym.
% ============================================================
\newif\iffiksjon@korrektur
\newif\iffiksjon@hefte
\DeclareOption{korrektur}{\fiksjon@korrekturtrue}
\DeclareOption{proof}{\fiksjon@korrekturtrue}
\DeclareOption{hefte}{\fiksjon@heftetrue}
\ProcessOptions\relax


% ============================================================
% fiksjonstil.sty — roman, noveller og kortprosa
%
% Alle typografiske valg bor i denne fila. Du skal ikke
% trenge å endre noe her for å sette en bok: skriv teksten i
% main.tex, med \kapittel, \novelle eller \kortprosa foran
% hver tekst.
%
%   \documentclass[12pt,twoside]{book}
%
% Papirformatet settes her og ikke i \documentclass, siden
% 128 x 204 mm ikke er et klassevalg. 12pt-valget gir
% størrelsene rundt brødteksten (\small, \large, \huge);
% brødteksten selv settes under.
%
% Motor: LuaLaTeX. Fonten er OpenType.
%
% Rekkefølgen nedenfor: språk, font, mikrotypografi, kjegle,
% geometri, sidefall, sidestil, hyperref, åpningene
% (kapitler, noveller, kortprosa), scenebrudd, deler,
% forstoffet, innholdet og heftet sist.
% ============================================================


% ============================================================
% SPRÅK
% ============================================================
\RequirePackage[norsk]{babel}


% ============================================================
% FONT
%
% Garamond Libre, samme skrift som de andre bokmalene.
% Minuskeltall i teksten og i sidetallene; kapitteltallene
% bruker ordinære tall (se ÅPNINGER). Ingen
% matematikkfont: stilen laster fontspec og ikke
% unicode-math.
% ============================================================
\RequirePackage{fontspec}

\setmainfont{GaramondLibre}[
  Extension      = .otf,
  UprightFont    = *-Regular,
  ItalicFont     = *-Italic,
  BoldFont       = *-Bold,
  BoldItalicFont = *-BoldItalic,
  Numbers        = OldStyle ]


% ============================================================
% MIKROTYPOGRAFI
%
% Teksten er justert, så både protrusion og expansion er på:
% protrusion henger tegnsetting litt ut i margen, og
% expansion gir jevnere ordmellomrom. tracking sperrer
% kapitelene.
% ============================================================
\RequirePackage[
  expansion=true,
  protrusion=true,
  tracking=true
]{microtype}


% ============================================================
% KJEGLE
%
% 11,75/15 bp, målt fra en norsk roman satt i Adobe Garamond.
% Garamond Libre har nesten samme tetthet: over 97 mm gir den
% rundt 57 tegn per linje. bp er punktet InDesign bruker, så
% tallene er de samme som i forbildet.
%
% \topskip er én linje, så første grunnlinje står én linje
% ned i satsflata, og hver linje på siden står i et fast
% grid med 15 bp mellom grunnlinjene.
% ============================================================
\renewcommand{\normalsize}{%
  \@setfontsize\normalsize{11.75bp}{15bp}%
  \let\@listi\@listI}
\normalsize
\setlength{\topskip}{15bp}
\setlength{\parindent}{1em}
\setlength{\parskip}{0pt}


% ============================================================
% SIDEGEOMETRI
%
% FORMAT. 128 x 204 mm, et vanlig norsk romanformat.
%
% SATSFLATE. 97 mm bred og 30 linjer høy. Toppen av
% versalene i første linje står 17 mm under arkets overkant,
% første grunnlinje 19,9 mm, siste 173,4 mm.
%
% MARGER. Innside 14 mm, utside 17 mm. Bunnmargen er
% resten, 30,6 mm, og sidetallet står i den.
%
%   innside  utside  topp   bunn
%     14      17     14,64  30,61  mm
%
% Toppmargen er til toppen av satsflata, som ligger én linje
% (\topskip) over første grunnlinje.
% ============================================================
\setlength{\paperwidth}{128mm}
\setlength{\paperheight}{204mm}

\RequirePackage{geometry}
\geometry{papersize={128mm,204mm},
  inner=14mm, outer=17mm, top=14.64mm,
  textheight=450bp, footskip=30bp}

% Sidekorrektur: siden sentrert på A4 med skjæremerker (cam)
% og crops informasjonslinje øverst — legg til noinfo i
% opsjonene under om du vil ha arket uten den.
\iffiksjon@korrektur
  \RequirePackage[cam,a4,center]{crop}
\fi


% ============================================================
% SIDEFALL
%
% Sidene står i fast grid og strekkes ikke. En side er full,
% 30 linjer, med to unntak: siste side i et kapittel slutter
% der teksten slutter, og en side blir én linje kortere når
% siste linje i et avsnitt ellers ville stått alene øverst
% på neste side (horunge). Første linje i et avsnitt kan
% stå alene nederst; å flytte den ville gitt korte sider
% langt oftere.
%
% Bunnen av hver side får strekk av orden fill, så en kort
% side står åpen nederst og ikke fordeler lufta mellom
% linjene.
% ============================================================
\raggedbottom
\def\@textbottom{\vskip\z@\@plus 1fill}
\widowpenalty=\@M
\clubpenalty=\z@
\brokenpenalty=\z@


% ============================================================
% SIDESTIL
%
% Sidetallet midtstilt nederst, to linjer under siste
% tekstlinje, 20 mm over arkets nederkant. Også på
% kapittelsidene. Ingen topptekst. Forstoffet og delsidene
% er uten sidetall, men telles med.
%
% emptypage holder de innskutte blanksidene helt tomme.
% ============================================================
\def\ps@fiksjon{%
  \let\@mkboth\@gobbletwo
  \let\@oddhead\@empty
  \let\@evenhead\@empty
  \def\@oddfoot{\hfil\thepage\hfil}%
  \let\@evenfoot\@oddfoot
}
\pagestyle{fiksjon}

\RequirePackage{emptypage}


% ============================================================
% HYPERLENKER
%
% Lenkene er svarte, så siden trykkes som uten dem, men
% innholdet er klikkbart i en PDF-leser. Kapitler, noveller,
% kortprosa med tittel og deler står som bokmerker. \\ i en
% tittel fjernes fra bokmerket; mellomrommet etter den blir
% stående.
% ============================================================
\RequirePackage{xcolor}
\RequirePackage{hyperref}
\hypersetup{
  colorlinks=true,
  allcolors=black
}

\pdfstringdefDisableCommands{\let\\\@empty}

\newcounter{fiksjon@anker}
\newcommand{\fiksjon@bokmerke}[2]{%
  \stepcounter{fiksjon@anker}%
  \pdfbookmark[#1]{#2}{fiksjon@anker.\arabic{fiksjon@anker}}%
}


% ============================================================
% ÅPNINGER
%
% Kapitler, noveller, kortprosa og innholdsfortegnelsen
% begynner alle på samme måte: en tom side ned til en gitt
% linje, eventuelt med en tittel eller et tall midtstilt
% på en linje over. Alt står i gridet, så linjene på en
% åpningsside står i høyde med linjene på siden ved siden
% av.
%
%   \fiksjon@aapning{tittellinje}{tekstlinje}
%
% setter innholdet i \fiksjon@tittelboks med første
% grunnlinje på tittellinja, og lar teksten begynne på
% tekstlinja. Er boksen tom, blir det bare luft.
%
% Titler står oppreist i \large, midtstilt, uten orddeling,
% på inntil 80 % av satsbredden. En lang tittel brytes, og
% hver linje står på neste gridlinje. \\ i tittelen
% bestemmer hvor den brytes; i innholdet og bokmerkene blir
% den et mellomrom.
%
% Tallene samlet, om noe skal justeres:
% ============================================================
\newcommand{\fiksjon@tallinje}{5}   % kapitteltall og novelletittel
\newcommand{\fiksjon@slipp}{12}     % første tekstlinje i kapitler og noveller
\newcommand{\fiksjon@kortlinje}{4}  % tittel på kortprosa og innhold
\newcommand{\fiksjon@dellinje}{10}  % tittel på delsider
\newcommand{\fiksjon@tallfont}{%
  \fontsize{24bp}{24bp}\selectfont\addfontfeatures{RawFeature=-onum}}
\newcommand{\fiksjon@tittelfont}{\large}

\newbox\fiksjon@tittelboks
\newcommand{\fiksjon@tittel}[1]{%
  \setbox\fiksjon@tittelboks\hbox{%
    \parbox[t]{0.8\textwidth}{%
      \centering\fiksjon@tittelfont
      \baselineskip=15bp
      \hyphenpenalty=\@M \exhyphenpenalty=\@M
      #1\par}}}

% Antall linjer i tittelen: én, pluss det som står under
% første grunnlinje delt på linjeavstanden (avrundet, så
% underlengdene i siste linje ikke teller).
\newcommand{\fiksjon@tittellinjer}{%
  \numexpr 1+\dp\fiksjon@tittelboks/\baselineskip\relax}

\newcommand{\fiksjon@aapning}[2]{%
  \par
  \vbox to \dimexpr\topskip+\baselineskip*(#2-2)\relax{%
    \ifvoid\fiksjon@tittelboks\else
      \kern\dimexpr\topskip+\baselineskip*(#1-1)\relax
      \vbox to\z@{\vss
        \hbox to\textwidth{\hfil\box\fiksjon@tittelboks\hfil}}%
    \fi
    \vfil}%
  \nobreak
  \@afterindentfalse
  \@afterheading
}


% ============================================================
% KAPITLER
%
%   \kapittel             nummerert: 1, 2, 3 ...
%   \kapittel[Epilog]     unummerert, med et ord i stedet
%
% Hvert kapittel begynner på en ny side, høyre eller
% venstre. Teksten begynner elleve linjer ned i satsflata,
% på tolvte linje, og tallet står midtstilt i lufta over,
% med grunnlinja på femte linje.
%
% Tallet er satt med ordinære tall: minuskeltall ville latt
% 3, 4, 5, 7 og 9 henge under linja og de andre ikke. Et
% unummerert kapittel får ordet som en tittel på samme
% linje, og telleren går ikke.
%
% Kapitlene står som bokmerker i PDF-en, men ikke i
% innholdsfortegnelsen. Første avsnitt får ikke innrykk.
% ============================================================
\DeclareRobustCommand{\kapittel}[1][]{%
  \clearpage
  \def\fiksjon@tmp{#1}%
  \ifx\fiksjon@tmp\@empty
    \refstepcounter{chapter}%
    \setbox\fiksjon@tittelboks\hbox{\fiksjon@tallfont\thechapter}%
    \fiksjon@bokmerke{0}{\thechapter}%
  \else
    \fiksjon@tittel{#1}%
    \fiksjon@bokmerke{0}{#1}%
  \fi
  \fiksjon@aapning{\fiksjon@tallinje}{\fiksjon@slipp}%
}


% ============================================================
% NOVELLER
%
%   \novelle{Tittel}
%   \novelle{En lang tittel\\ brutt der du vil}
%
% Hver novelle begynner på en høyreside, med samme åpning
% som et kapittel: tittelen på femte linje og teksten på
% tolvte. Novellene står i innholdsfortegnelsen og som
% bokmerker.
% ============================================================
\DeclareRobustCommand{\novelle}[1]{%
  \cleardoublepage
  \phantomsection
  \addcontentsline{toc}{fiksjontekst}{#1}%
  \fiksjon@tittel{#1}%
  \fiksjon@aapning{\fiksjon@tallinje}{\fiksjon@slipp}%
}


% ============================================================
% KORTPROSA
%
%   \kortprosa            uten tittel
%   \kortprosa[Tittel]    med tittel
%
% Hver tekst begynner på en ny side, høyre eller venstre,
% høyere opp enn et kapittel: tittelen står på fjerde linje
% og teksten én tom linje under siste tittellinje, altså på
% sjette når tittelen er på én linje. Uten tittel begynner
% teksten på fjerde linje, der tittelen ellers ville stått.
%
% Kortprosa med tittel står i innholdsfortegnelsen og som
% bokmerke; uten tittel står den ingen av stedene.
% ============================================================
\DeclareRobustCommand{\kortprosa}[1][]{%
  \clearpage
  \def\fiksjon@tmp{#1}%
  \ifx\fiksjon@tmp\@empty
    \setbox\fiksjon@tittelboks\box\voidb@x
    \fiksjon@aapning{\fiksjon@kortlinje}{\fiksjon@kortlinje}%
  \else
    \phantomsection
    \addcontentsline{toc}{fiksjontekst}{#1}%
    \fiksjon@tittel{#1}%
    \fiksjon@aapning{\fiksjon@kortlinje}%
      {\the\numexpr\fiksjon@kortlinje+\fiksjon@tittellinjer+1\relax}%
  \fi
}


% ============================================================
% SCENEBRUDD
%
%   ... siste avsnitt i en scene.
%   \scenebrudd
%   Første avsnitt i neste scene ...
%
% Én blank linje, og neste avsnitt uten innrykk. Faller
% bruddet nederst på en side, står siden med en tom linje
% til slutt, og neste scene begynner øverst på neste side.
% Faller det helt øverst, forsvinner det, som i trykte bøker
% med blank linje som skille.
% ============================================================
\newcommand{\scenebrudd}{%
  \par
  \vskip\baselineskip
  \everypar{{\setbox\z@\lastbox}\everypar{}}%
}


% ============================================================
% DELER
%
%   \del{Første del}
%   \del{I}
%
% Deler boka i deler. Tittelen står alene i kapiteler på en
% høyreside uten sidetall, på tiende linje, omtrent en
% tredjedel ned, og baksiden er blank, så første kapittel
% eller novelle i delen begynner på en høyreside.
% Kapitteltellingen fortsetter gjennom delene. Delene står
% i innholdsfortegnelsen og som bokmerker.
%
% Definert med \DeclareRobustCommand fordi den engelske
% utgaven heter \part og erstatter klassens kommando; de to
% stilfilene skal være like.
% ============================================================
\DeclareRobustCommand{\del}[1]{%
  \cleardoublepage
  \thispagestyle{empty}%
  \phantomsection
  \addcontentsline{toc}{fiksjondel}{#1}%
  \setbox\fiksjon@tittelboks\hbox{\large\scshape #1}%
  \fiksjon@aapning{\fiksjon@dellinje}%
    {\the\numexpr\fiksjon@dellinje+2\relax}%
  \cleardoublepage
}


% ============================================================
% SMUSSTITTEL
%
%   \halftitlepage
%
% Bokas første side: bare tittelen, liten, på en høyreside
% med blank bakside. Valgfri, og kommentert ut i main.tex:
% uten den begynner boka på tittelsiden.
% ============================================================
\def\@subtitle{}
\newcommand{\subtitle}[1]{\gdef\@subtitle{#1}}

\newcommand{\halftitlepage}{%
  \cleardoublepage
  \thispagestyle{empty}%
  \null
  \vskip 0.18\textheight
  \begin{center}
    \large\scshape \@title
  \end{center}
  \cleardoublepage
}


% ============================================================
% TITTELSIDE
%
%   \title{...}  \author{...}  \date{...}
%   \subtitle{...}                 % valgfritt, f.eks. «Roman»
%   \booktitlepage
%
% Samme oppbygning som i de andre bokmalene: tittel i store
% kapiteler, kursiv undertittel om den er satt, forfatter
% under, og dato nederst. I \date kan det like gjerne stå et
% forlag eller et sted.
% ============================================================
\newcommand{\booktitlepage}{%
  \cleardoublepage
  \thispagestyle{empty}%
  \null
  \vskip 0.18\textheight
  \begin{center}
    {\huge\scshape \@title \par}
    \ifx\@subtitle\@empty\else
      \vspace{1.4em}
      {\large\itshape \@subtitle \par}
    \fi
    \vspace{3em}
    {\large \@author \par}
  \end{center}
  \vskip\z@\@plus 1filll
  \begin{center}
    {\normalsize\itshape \@date \par}
  \end{center}
  \clearpage
}


% ============================================================
% KOLOFON
%
%   \colophonpage{%
%     © 2026 Forfatternavn\\
%     Satt med Garamond Libre\\
%     ISBN 978-82-000-0000-0}
%
% Baksiden av tittelsiden: rettigheter, trykk og ISBN, liten
% skrift nederst på siden. Skill linjene med \\.
% ============================================================
\newcommand{\colophonpage}[1]{%
  \clearpage
  \thispagestyle{empty}%
  \null
  \vskip\z@\@plus 1filll
  {\small\raggedright #1\par}
  \clearpage
}


% ============================================================
% DEDIKASJONSSIDE
%
%   \dedicationpage{Til noen.}
%
% Én kort kursiv linje, sentrert en fjerdedel ned på en
% høyreside, fulgt av en blank bakside.
% ============================================================
\newcommand{\dedicationpage}[1]{%
  \cleardoublepage
  \thispagestyle{empty}%
  \null
  \vskip 0.25\textheight
  \begin{center}
    \itshape #1
  \end{center}
  \cleardoublepage
}


% ============================================================
% INNHOLD
%
%   \innhold
%
% Innholdsfortegnelse over deler, noveller og kortprosa med
% tittel. Kapitler står ikke der: en roman med nummererte
% kapitler trenger sjelden en innholdsfortegnelse, og
% kommandoen kan bare utelates.
%
% Begynner på en høyreside uten sidetall, med «Innhold» som
% tittel på fjerde linje, som kortprosa, og det som følger
% begynner på neste høyreside. Kan stå sist i forstoffet
% eller bakerst i boka.
%
% Hver tekst står på én linje i gridet, med sidetallet mot
% høyre kant og ingen punktledere. En tittel som er for lang
% for linja, brytes og får hengende innrykk. Delene står i
% kapiteler med én linjes luft over, bortsett fra øverst.
% ============================================================
\newcommand*{\l@fiksjontekst}[2]{%
  {\def\\{\unskip\space\ignorespaces}%
   \leftskip\z@
   \rightskip 2.5em
   \parfillskip -2.5em
   \hangindent 1.5em
   \hangafter\@ne
   \hyphenpenalty\@M
   \noindent #1\nobreak\hfill\nobreak
   \hb@xt@ 2.5em{\hss #2}\par}%
}
\newcommand*{\l@fiksjondel}[2]{%
  \if@nobreak\else\addvspace{\baselineskip}\fi
  {\def\\{\unskip\space\ignorespaces}\noindent\scshape #1\par}%
  \nobreak
}
\newcommand*{\toclevel@fiksjondel}{-1}
\newcommand*{\toclevel@fiksjontekst}{0}

\newcommand{\innhold}{%
  \cleardoublepage
  \pagestyle{empty}%
  \fiksjon@tittel{\contentsname}%
  \fiksjon@aapning{\fiksjon@kortlinje}%
    {\the\numexpr\fiksjon@kortlinje+2\relax}%
  \@starttoc{toc}%
  \cleardoublepage
  \pagestyle{fiksjon}%
}


% ============================================================
% HEFTE
%
% Med opsjonen hefte fylles boka opp med blanke sider til
% sidetallet er delelig med fire, som et falset og stiftet
% hefte krever. Den siste av dem er heftets bakside, så
% heftet lukkes med en blank side og ikke med siste
% tekstside. \numexpr runder ved divisjon, så resten regnes
% med \divide, som trunkerer.
% ============================================================
\newcommand{\fiksjon@fyllopp}{%
  \@tempcnta=\numexpr\value{page}-1\relax
  \@tempcntb=\@tempcnta
  \divide\@tempcntb by 4
  \multiply\@tempcntb by 4
  \ifnum\@tempcnta>\@tempcntb
    \thispagestyle{empty}\null\clearpage
    \expandafter\fiksjon@fyllopp
  \fi}

\iffiksjon@hefte
  \AtEndDocument{\clearpage\fiksjon@fyllopp}
\fi


% ============================================================
% SLUTT PÅ FIL
% ============================================================
\endinput
