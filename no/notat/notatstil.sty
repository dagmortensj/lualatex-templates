\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{notatstil}[2026/09/02 v1.10 Notatstil — CUP-inspirert boktypografi i artikkelformat]

% ============================================================
% notatstil.sty — langformede notater
%
% Til notater i teoretisk fysikk og matematikk i
% artikkellengde: for langt til en handout, ikke en
% monografi. Den tar bokstilens typografi inn i
% artikkelformat og legger til en innrammet
% innholdsfortegnelse, teorem- og oppgaveomgivelser, og
% Python med syntaksutheving.
%
% Alt om hvordan notatene ser ut settes her; main.tex
% inneholder innholdet og eventuelle ekstra pakker.
%
% Motor: LuaLaTeX. Fonten er OpenType og lastes gjennom
% unicode-math, og det kan ikke pdflatex.
%
% Rekkefølgen nedenfor: språk, fonter, farger, geometri,
% avstander, seksjonering med slukeregel, sidemøblering,
% strukturerte omgivelser, viktig-bokser, hyperref og
% siteringer sist.
% ============================================================


% ============================================================
% SPRÅK
%
% babel lastes her og ikke i main.tex, slik at det å laste
% stilen er nok til å få orddeling og tegnsetting riktig.
% Bytt språk på linja under.
% ============================================================
\RequirePackage[norsk]{babel}


% ============================================================
% TALL OG ENHETER (siunitx)
%
% main.tex laster siunitx når et dokument trenger \qty og
% \num; stilen bærer språkvalgene, så et dokument som laster
% pakka får norsk sats uten å sette opp noe selv. Kroken
% kjører i det øyeblikket siunitx lastes -- før resten av
% preamble -- så en \sisetup i main.tex overstyrer fortsatt
% det som står her. Gjør ingenting i et dokument som aldri
% laster siunitx.
%
% Valgene følger Språkrådet og NS-ISO 80000-1:
%   desimalkomma          6,63 -- ikke 6.63
%   halvhøy prikk         6,63 · 10^-34 -- ikke kryss; ISO
%                         forbeholder krysset for
%                         desimalpunktum-tradisjonen
%   «til» og «og»         \qtyrange: 10 km til 20 km,
%                         \qtylist: 1 V, 2 V og 3 V
%   skråstrek i enheter   m/s^2 -- ikke m s^-2; lærebok,
%                         ikke tidsskrift
%   samlet usikkerhet     (9,81 ± 0,03) m/s^2
%
% Resten er siunitx sine standarder og skal stå: tynt
% mellomrom rundt gangetegnet og mellom tall og enhet (som
% hos Griffiths), tusenskille med tynt mellomrom fra fem
% sifre (10 000, men 1000), og mellomrom foran %.
% ============================================================
\AddToHook{package/siunitx/after}{%
  \sisetup{
    output-decimal-marker = {,},
    exponent-product      = \cdot,
    range-phrase          = { til },
    list-final-separator  = { og },
    list-pair-separator   = { og },
    per-mode              = symbol,
    separate-uncertainty  = true,
  }%
}


% ============================================================
% FONT OG MIKROTYPOGRAFI
%
% NewComputerModern, tekst og matematikk fra samme familie.
% Det er Computer Modern tegnet på nytt med mer tyngde på
% arket, noe som overlever laserutskrift der Latin Modern
% blir tynn. Pakka gir deg Book-vekta som standard;
% [regular] ville hentet tilbake den tynnere originalen.
%
% Den laster unicode-math selv, så det står ingen egen
% \setmathfont her. Fet matematikk er \symbf, \symbfit,
% \symbfup — \bm og \boldmath hører pdflatex-tida til og
% virker ikke her. Se README.
%
% protrusion henger tegnsetting ut i margen, expansion
% strekker glyffene brøkdeler av en prosent for å unngå løse
% linjer, og tracking sperrer kapitelene.
% ============================================================
\RequirePackage{newcomputermodern}

\RequirePackage[
  expansion=true,
  protrusion=true,
  tracking=true
]{microtype}


% ============================================================
% FARGER
%
% Tre farger med faste roller, så et dokument aldri trenger
% å finne på en ny:
%
%   darkred      hyperlenker, fotnotelinje, \separator
%   darkorange   figurer: streker, noder, fylte områder
%   darkolive    figurer: andrefarge til kurver og fyll
%
% Hold darkred utenfor figurer — den leses som struktur, ikke
% innhold. Svart og grå er tilgjengelig til akser og
% sekundære etiketter.
%
% Definert tidlig så darkred finnes når \separator og
% hyperref vil ha den.
% ============================================================
\RequirePackage{xcolor}
\definecolor{darkred}   {RGB}{120, 20,  20}
\definecolor{darkorange}{RGB}{184, 92,   0}
\definecolor{darkolive} {RGB}{ 74,107,  18}


% ============================================================
% SIDEGEOMETRI (A4, SYMMETRISK)
%
% 3 cm hele veien rundt gir en satsbredde på 150 mm. Ved
% 11pt er det 3,06 lilleboksalfabeter — bredere enn vinduet
% på 1,8–2,4 som Bringhurst gir for løpende prosa, og
% bredere enn bokmalens 2,36. Det er den vanlige byttehandelen
% for notater: viste ligninger og lange utledninger vil ha
% bredden mer enn prosaen vil ha korte linjer, og kjegla
% nedenfor er åpnet litt for å kompensere.
%
% Utvid margene til 4 cm for en satsbredde på 130 mm (2,65)
% hvis et dokument viser seg å bli mest tekst.
% ============================================================
\RequirePackage[
  a4paper,
  left=3.0cm,
  right=3.0cm,
  top=2.7cm,
  bottom=3.0cm
]{geometry}


% ============================================================
% AVSNITT OG KJEGLE
%
% Innrykkede avsnitt uten luft mellom dem, som i en bok.
% \setstretch{1.07} tar grunnlinjen fra 13,6 pt til
% 14,55 pt — kompensasjonen for den lange satsbredden over.
% ============================================================
\setlength{\parindent}{15pt}
\setlength{\parskip}{0pt}

\RequirePackage{setspace}
\setstretch{1.07}


% ============================================================
% AVSTAND RUNDT VISTE LIGNINGER
%
% Delt med bokstilen, så de to leses som en familie.
%
%   over   12pt     etter en kort innledende linje   7pt
%   under  12pt     alltid                          12pt
%
% Bare avstanden over krymper etter en kort linje, siden en
% kort linje allerede gir luft av seg selv — og den krymper
% aldri til null, som er det klemte uttrykket klassens
% standard (0pt) gir. Avstanden under er alltid full, så
% luften under en ligning avhenger aldri av hva som kom før.
%
% \AtBeginDocument er ikke pynt. \begin{document} kjører
% \normalsize, som nullstiller alle fire skipene til
% klassens standard, så verdier satt i preamblet blir stille
% forkastet. Senere størrelsesendringer er grupperte og
% gjenoppretter disse når de avsluttes.
% ============================================================
\AtBeginDocument{%
  \setlength{\abovedisplayskip}{12pt plus 3pt minus 3pt}%
  \setlength{\belowdisplayskip}{12pt plus 3pt minus 3pt}%
  \setlength{\abovedisplayshortskip}{7pt plus 3pt minus 3pt}%
  \setlength{\belowdisplayshortskip}{12pt plus 3pt minus 3pt}%
}


% ============================================================
% FIGURTEKSTER
%
%   font=small       ett steg under kroppsteksten
%   labelfont=bf     fet «Figur 1.»-etikett
%   labelsep=period  punktum etter nummeret, ikke kolon
%
% Figurtekster på én linje sentrerer seg selv; lengre tekst
% blir justert. Begge deler er caption sin standard.
% ============================================================
\RequirePackage[font=small,labelfont=bf,labelsep=period]{caption}


% ============================================================
% SEKSJONERING
%
% Tre nivåer, alle fete og oppreiste — kapiteler er
% reservert for tittelblokka. Størrelse og vekt bærer
% hierarkiet; ingen streker, ingen farge.
%
% Underseksjoner og oppover er nummererte og står i
% innholdsfortegnelsen. Underunderseksjoner er nummererte,
% men holdes utenfor: de er et run-in-nivå (se nedenfor),
% ment til å merke et steg inne i en utledning heller enn å
% strukturere dokumentet.
% ============================================================
\RequirePackage{titlesec}

% Seksjoner
\titleformat{\section}
  {\normalfont\Large\bfseries}
  {\thesection}{0.8em}{}

\titlespacing*{\section}
  {0pt}{4.5ex plus 1.5ex minus .5ex}{2.4ex plus .4ex}

% Underseksjoner
\titleformat{\subsection}
  {\normalfont\large\bfseries}
  {\thesubsection}{0.8em}{}

\titlespacing*{\subsection}
  {0pt}{4.0ex plus 1.2ex minus .4ex}{1.8ex plus .4ex}

% Underunderseksjoner er run-in: tittelen starter avsnittet
% og teksten følger på samme linje. Dypere går ikke
% hierarkiet — noe finere vil ha en ny seksjon.
\titleformat{\subsubsection}[runin]
  {\normalfont\normalsize\bfseries}
  {\thesubsubsection}{0.5em}{}

\titlespacing*{\subsubsection}
  {0pt}{2.2ex plus .6ex minus .2ex}{0.6em}

% Nummerert ned til underunderseksjon, ført opp ned til
% underseksjon.
\setcounter{tocdepth}{2}


% ============================================================
% OVERSKRIFTER SLUKER BLOKKLUFT
%
% titlesec legger luften over en overskrift med \vspace, ikke
% \addvspace, så den stables oppå avstanden en oppgave eller
% et teorem etterlater seg — og overgangen ser ut som et hull.
% Denne kroken kjøres før hver overskrift: den samler opp
% etterlatt vertikal lim (glue) og setter bare inn det som
% eventuelt overstiger overskriftens egen luft. Resultatet er
% maksimum, ikke sum — samme semantikk som \addvspace.
% Overskuddet settes inn som \kern, ikke glue: titlesec
% absorberer foranliggende glue i sin egen luft, og en kern
% kan ikke absorberes — men forkastes pent ved sideskift.
%
% Kjent rest: et teorem som avslutter en seksjon etterlater
% limen sin bak en penalty i LaTeX' vedlikeholdsliste, og den
% kan ikke fjernes derfra. Overgangen teorem->overskrift blir
% derfor postskip (2,8 ex) for stor — mildt, og eldre enn
% denne stilen. Oppgaver rammes ikke: de legger limen sist.
% ============================================================
\makeatletter
\newcommand{\overskriftsluk}[1]{%
  \par
  \@tempskipb\z@skip
  \@whiledim\lastskip>\z@\do{%
    \advance\@tempskipb\lastskip
    \removelastskip}%
  \ifdim\@tempskipb>#1\relax
    \kern\dimexpr\@tempskipb-#1\relax
  \fi}
\makeatother
\AddToHook{cmd/section/before}{\overskriftsluk{4.5ex}}
\AddToHook{cmd/subsection/before}{\overskriftsluk{4.0ex}}


% ============================================================
% SIDESTIL
%
% Ingen løpende topptekst; sidetallet sentrert nederst.
% ============================================================
\pagestyle{plain}


% ============================================================
% TITTELBLOKK
%
%   \title{...}  \author{...}  \date{...}
%   \maketitle
%
% Tittel i store kapiteler, en femtedel ned på siden, med
% forfatter og dato under. \thanks-fotnoter på denne siden
% merkes med symboler (*, †, ‡) i stedet for tall, så de
% ikke forstyrrer fotnotetellingen i brødteksten.
% ============================================================
\makeatletter
\renewcommand{\maketitle}{%
  \thispagestyle{plain}
  \vspace*{0.22\textheight}
  \begingroup
    % Tittelside-fotnoter (\thanks) bruker symboler: *, \dag, \ddag, ...
    \renewcommand\thefootnote{\@fnsymbol\c@footnote}%
    \begin{center}
      {\huge\scshape \@title \par}
      \vspace{2.8em}
      {\large \@author \par}
      \vspace{0.7em}
      {\normalsize \@date \par}
    \end{center}
    \@thanks
  \endgroup
  \vspace{4.5em}%
  \setcounter{footnote}{0}%
  \global\let\@thanks\@empty
}
\makeatother


% ============================================================
% SAMMENDRAG
%
%   \begin{abstract} ... \end{abstract}
%
% En fet, sentrert etikett over en blokk satt til 88 % av
% satsbredden, med kjegla tilbake til enkel. Det er den
% smalere blokka som markerer at dette står utenfor
% brødteksten; etiketten alene ville ikke gjort det.
% ============================================================
\makeatletter
\renewenvironment{abstract}{%
  \par
  \centering
  {\small\bfseries \abstractname\par}
  \vspace{10pt}
  \begin{minipage}{0.88\textwidth}
    \small
    \setstretch{1.0}
}{%
  \end{minipage}
  \par
  \vspace{2.2em}
}
\makeatother


% ============================================================
% INNHOLDSFORTEGNELSE
%
%   \framedtoc
%
% En linje over «Innhold»-tittelen og en under siste
% oppføring, JHEP-stil, uten punktledere:
%
%   ------------------------------
%   Innhold
%   1  Seksjon .................. 2
%   ------------------------------
%
% Vanlig \tableofcontents virker fortsatt om du vil ha den
% uinnrammet. main.tex legger \framedtoc på egen side.
% ============================================================
\RequirePackage{tocloft}

% Ingen punktledere
\renewcommand{\cftsecleader}{\hfill}
\renewcommand{\cftsubsecleader}{\hfill}

% Valgfri breddejustering (trygge standardverdier)
\setlength{\cftsecnumwidth}{2.5em}
\setlength{\cftsubsecnumwidth}{3.0em}

% \tableofcontents redefineres bevisst IKKE: å pakke den inn
% kolliderer med hyperrefs eget oppsett av de fargede
% innholdslenkene. \framedtoc kaller i stedet den
% ferdig-initialiserte \tableofcontents ved bruk. Linjene er
% \rule-bokser, ikke \hrule — en ren \hrule før tittelen blir
% slukt.
\newlength{\tocrulewidth}
\setlength{\tocrulewidth}{0.4pt}

\newcommand{\framedtoc}{%
  \noindent\rule{\linewidth}{\tocrulewidth}\par
  \vspace{1.0ex}%
  \tableofcontents
  \par\vspace{1.0ex}%
  \noindent\rule{\linewidth}{\tocrulewidth}\par
}


% ============================================================
% TEOREMOMGIVELSER
%
%   \begin{teorem} ... \end{teorem}
%   \begin{definisjon} ... \end{definisjon}
%   \begin{merknad} ... \end{merknad}
%
% Alle tre deler én teller, knyttet til seksjonen: Teorem
% 2.1, Definisjon 2.2, Merknad 2.3. Legg til flere med
% \newtheorem{lemma}[teorem]{Lemma} i main.tex for å holde
% dem i samme rekke.
%
% \proofname settes til «Bevis» her, siden babel ikke
% nødvendigvis oversetter den.
%
% amsthm lastes én gang her; oppgaveomgivelsen lenger ned
% bruker den også.
% ============================================================
\RequirePackage{amsthm}

% --- Luft rundt dem ---
% amsthms standard er \topsep, stram nok til at et teorem
% trenger seg mot prosaen rundt. \thm@space@setup hever den
% og jevner ut over og under. Bare vertikal avstand røres:
% fonter, hode og innrykk står som amsthm setter dem.
%
% amsthms 'remark'-stil halverer så det den arver.
% \th@remark defineres på nytt for å droppe kun den
% halveringen — den kursiverte hodefonten og den oppreiste
% brødfonten beholdes — så en merknad sitter på siden slik
% et teorem gjør.
\makeatletter
\def\thm@space@setup{%
  \setlength\thm@preskip{2.8ex plus 1ex minus .4ex}%
  \setlength\thm@postskip{\thm@preskip}%
}
\def\th@remark{\thm@headfont{\itshape}\normalfont}
\makeatother

\theoremstyle{plain}
\newtheorem{teorem}{Teorem}[section]

\theoremstyle{definition}
\newtheorem{definisjon}[teorem]{Definisjon}

\theoremstyle{remark}
\newtheorem{merknad}[teorem]{Merknad}

\renewcommand{\proofname}{Bevis}


% ============================================================
% SEPARATORLINJE
%
%   \separator
%
% En kort mørkerød linje med luft på begge sider, til et
% temaskifte inne i en seksjon, eller mellom eksempler og
% etter oppgaver. Den er stillere enn en overskrift, og det
% er poenget: den markerer et brudd uten å ta et nivå i
% hierarkiet.
%
% Den låner fotnotelinjens bredde, lagret her som
% \orig@footnoterule før hyperref lenger ned kan redefinere
% \footnoterule. Den innledende \par lukker et åpent avsnitt,
% så \separator er trygg rett etter løpende tekst.
% ============================================================
\makeatletter
\let\orig@footnoterule\footnoterule
\newcommand{\separator}{%
  \par
  \vspace{3.5ex plus 1.5ex minus .5ex}
  {\color{darkred}\orig@footnoterule}
  \vspace{1.2ex}
}
\makeatother


% ============================================================
% OPPGAVER
%
%   \begin{oppgave}[Valgfri tittel]
%   Oppgavetekst.
%   \begin{deloppgaver}
%     \item Første del.
%     \item Andre del.
%   \end{deloppgaver}
%   \end{oppgave}
%
% Nummerert per seksjon og talt uavhengig av teoremer, så
% Oppgave 2.1 kan stå ved siden av Teorem 2.4. Med tittel
% leser hodet «Oppgave 2.1 - Tittel».
%
% Delt med handout-stilen, så et oppgavesett kan flyttes
% mellom de to uendret. amsthm kommer fra teoremseksjonen
% over; enumitem driver deloppgavene.
% ============================================================
\RequirePackage{enumitem}

% --- Oppgave-omgivelse ---
\newtheoremstyle{notatex}
  {1ex}              % avstand over
  {1ex}              % avstand under
  {\normalfont}      % kroppsfont
  {0pt}              % innrykk
  {\bfseries}        % hodefont
  {}                 % hodetegnsetting
  {\newline}         % avstand mellom hode og kropp
  {\thmname{#1}\thmnumber{ #2}\thmnote{ - \bfseries#3}}

\theoremstyle{notatex}
\newtheorem{oppgaveinner}{Oppgave}[section]
\renewcommand{\theoppgaveinner}{\thesection.\arabic{oppgaveinner}}

% Tilbake til amsthms standard, så en \newtheorem lagt til
% senere i main.tex starter fra 'plain' og ikke fra
% oppgavestilen.
\theoremstyle{plain}

% {\newline}-skillet over setter kroppen på egen linje under
% den fete etiketten; \leavevmode\par\vspace{-2ex} trekker
% den så opp igjen til et tett mellomrom. -2ex er
% font-relativ, så den følger linjehøyden på tvers av
% størrelser.
%
% Luft: 4,5 ex før og 6,75 ex etter — ett basisvalg og én
% ratio (1,5), plassert i familiens ex-skala mellom
% separatoren (3,5) og seksjonsluften. Mindre rom før binder
% oppgaven til innledningen sin i prosaen; større rom etter
% markerer at enheten er avsluttet. \addvspace tar maksimum
% av tilstøtende avstander, så to oppgaver på rad får 6,75 ex
% av seg selv. \parindent nulles i hele kroppen, som i den
% gamle quote-formen, så deloppgavene leses som innrykket.
\newenvironment{oppgave}[1][]
{%
  \par\addvspace{4.5ex plus 1.5ex minus .8ex}
  \setlength{\parindent}{0pt}%
  \boksnullteoremluft
  \def\tmp{#1}\ifx\tmp\empty
    \begin{oppgaveinner}\leavevmode\par\vspace{-2ex}
  \else
    \begin{oppgaveinner}[#1]\leavevmode\par\vspace{-2ex}
  \fi
}
{%
  \end{oppgaveinner}
  \par\addvspace{6.75ex plus 2.2ex minus 1.2ex}
}

% --- Deloppgaver: a), b), c) ---
%
% En egen liste i stedet for en global \setlist, så vanlige
% enumerate-lister ellers beholder standardnummereringen.
% Skriv forklarende tekst mellom delene som vanlig tekst
% utenfor omgivelsen, og ta bokstavene opp igjen med
% \begin{deloppgaver}[resume].
%
% Etikettene er magre, som i læreboktradisjonen — det fete
% oppgavehodet bærer navigasjonen alene. Innrykket er
% \leftmargini — samme venstrekant som vanlige
% enumerate- og itemize-lister, så alle lister i et dokument
% deler ett grid.
\newlist{deloppgaver}{enumerate}{1}
\setlist[deloppgaver]{%
  label=\alph*),
  leftmargin=\leftmargini,
  labelsep=0.6em,
  itemsep=0.8ex,
  parsep=0.8ex,
  topsep=0.8ex
}


% ============================================================
% KODEEKSEMPLER
%
%   \begin{python}
%   def f(x):
%       return x**2
%   \end{python}
%
% Python med Gruvbox Light-utheving, linjenummer og en linje
% over og under. listings gjør parsingen selv, så det trengs
% ingen shell-escape og ingen eksterne verktøy — dokumentet
% kompilerer hvor som helst.
%
% æ, ø og å er kartlagt eksplisitt nederst i stilen:
% listings leser inndata byte for byte og ville ellers
% mistet dem i kodekommentarer.
%
% Gruvbox Light Hard (gruvbox.dayle.io):
%   bakgrunn    #fdfcf2   forgrunn    #3c3836
%   nøkkelord   #9d0006   strenger    #79740e
%   kommentarer #928374   tall        #b57614
% ============================================================
\RequirePackage{listings}

\definecolor{gruvbg}    {HTML}{fdfcf2}
\definecolor{gruvfg}    {HTML}{3c3836}
\definecolor{gruvkw}    {HTML}{9d0006}
\definecolor{gruvstr}   {HTML}{79740e}
\definecolor{gruvcom}   {HTML}{928374}
\definecolor{gruvnum}   {HTML}{b57614}
\definecolor{gruvbi}    {HTML}{076678}

\lstdefinestyle{gruvboxlight}{
  backgroundcolor   = \color{gruvbg},
  basicstyle        = \small\ttfamily\color{gruvfg},
  keywordstyle      = \color{gruvkw}\bfseries,
  stringstyle       = \color{gruvstr},
  commentstyle      = \color{gruvcom}\itshape,
  numberstyle       = \color{gruvnum},
  identifierstyle   = \color{gruvfg},
  breaklines        = true,
  showstringspaces  = false,
  numbers           = left,
  numbersep         = 10pt,
  frame             = tb,
  xleftmargin       = 2em,
  xrightmargin      = 0em,
  framexleftmargin  = 2em,
  framexrightmargin = 0em,
  aboveskip         = 2.4ex,
  belowskip         = 2.4ex,
  extendedchars     = true,
  inputencoding     = utf8,
  literate          =
    {æ}{{\ae}}1 {ø}{{\o}}1 {å}{{\aa}}1
    {Æ}{{\AE}}1 {Ø}{{\O}}1 {Å}{{\AA}}1
}

\lstnewenvironment{python}
  {\lstset{language=Python, style=gruvboxlight,
           morekeywords={True,False,None,self}}}
  {}


% ============================================================
% VEKTORPILER (esvect)
%
% main.tex laster esvect når et dokument vil ha \vv-piler;
% stilen bærer bare størrelsesfiksen pakka trenger under
% unicode-math. esvect sin egen fontdefinisjon lister bare
% eksakte størrelser (5, 6, ..., 10 pt), mens unicode-math ber
% om brøkne mattestørrelser -- NewCM sin scriptscript er
% 0,50 x 10,95 = 5,475 pt -- og LaTeX bytter bare stille
% innenfor 0,4 pt; uten fiksen blir pilene i subskript rundt
% 9 % for små, med advarsel. Sammenhengende intervaller dekker
% alle størrelser -- samme fiks som forfatteren av overarrows
% tok inn upstream. Vaktet, så den gjør ingenting i et dokument
% som aldri laster esvect.
% ============================================================
\AtBeginDocument{%
  \IfPackageLoadedTF{esvect}{%
    \DeclareFontFamily{U}{esvect}{}%
    \DeclareFontShape{U}{esvect}{m}{n}{%
      <-5.5>    vect5
      <5.5-6.5> vect6
      <6.5-7.5> vect7
      <7.5-8.5> vect8
      <8.5-9.5> vect9
      <9.5->    vect10
    }{}%
  }{}%
}


% ============================================================
% VIKTIG-BOKSER
%
%   \begin{viktig}
%     \begin{definisjon} ... \end{definisjon}
%   \end{viktig}
%
%   \begin{hovedresultat}[Gravitasjonsloven]   % tittel valgfri
%     \begin{teorem} ... \end{teorem}
%   \end{hovedresultat}
%
% To omslag for det som fortjener å løftes fra prosaen.
% viktig setter tynne mørkerøde linjer over og under — samme
% vekt som separatorlinjen — og er tenkt rundt viktige
% definisjoner. hovedresultat setter en hårfin ramme rundt
% dokumentets sentrale resultat; med valgfritt argument står
% tittelen i sperrede kapiteler brutt inn i den øvre
% rammelinjen, slik eldre oppslagsverk satte titler, og uten
% står rammen ren.
%
% Begge er omslag, ikke egne teorem-typer: teller og
% nummerering hører til omgivelsen innenfor, så en bokset
% definisjon står i samme rekke som en ubokset — og
% unummerert modus følger med av seg selv. Bruk dem
% sparsomt: bokses alt, er boksen ikke lenger et signal.
%
% Boksene er brytbare over sideskift. Teoremomgivelsenes
% egen luft over og under nulles inne i boksen — den er
% dimensjonert mot prosa, og oppå boksens polstring ville
% den blitt dobbel. \thm@space@setup kjøres av amsthm ved
% hver omgivelsesstart, så en lokal omdefinisjon inne i
% boksgruppen er nok.
% ============================================================
\RequirePackage[skins,breakable]{tcolorbox}

\makeatletter
\newcommand{\boksnullteoremluft}{%
  \def\thm@space@setup{%
    \setlength\thm@preskip{\z@}%
    \setlength\thm@postskip{\z@}}}
\makeatother

\tcbset{boksgrunn/.style={
  enhanced, breakable, sharp corners,
  boxrule=0pt, frame hidden, colback=white,
  left=0pt, right=0pt, top=1.6ex, bottom=1.6ex,
  before skip=3.2ex plus 1ex minus .4ex,
  after skip=3.2ex plus 1ex minus .4ex,
  parbox=false,
  before upper=\boksnullteoremluft
}}

\newtcolorbox{viktig}{boksgrunn,
  borderline north={0.5pt}{0pt}{darkred},
  borderline south={0.5pt}{0pt}{darkred}
}

\NewTColorBox{hovedresultat}{o}{boksgrunn,
  borderline={0.4pt}{0pt}{darkred},
  left=1.2em, right=1.2em, top=1.8ex, bottom=1.8ex,
  IfValueT={#1}{
    top=2.2ex,
    attach boxed title to top left=
      {xshift=1.0em, yshift=-\tcboxedtitleheight/2},
    boxed title style={colback=white, frame hidden,
      boxrule=0pt, sharp corners,
      left=0.45em, right=0.45em, top=0pt, bottom=0pt},
    title={\footnotesize\scshape\lsstyle\color{darkred}#1}
  }
}


% ============================================================
% HYPERLENKER
%
% Lastes nesten sist, fordi hyperref patcher kommandoer
% andre pakker definerer; bare biblatex står etter.
% Mørkerød i stedet for standardblå: den
% holder seg lesbar når notatene trykkes i gråtoner. Sett
% \hypersetup{hidelinks} i main.tex for ingen farge i det
% hele tatt.
% ============================================================
\RequirePackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=darkred,
  citecolor=darkred,
  urlcolor=darkred,
  linktoc=page
}


% ============================================================
% SITERINGER
%
%   \cite{nokkel}         [1]
%   \cite{a,b,c}          sortert og komprimert, [1-3]
%   \addbibresource{referanser.bib}   i preamblet i main.tex
%   \printbibliography                sist i main.tex
%
% biblatex med biber, ikke natbib med bibtex — latexmk
% kjører biber av seg selv. sorting=none lister referansene
% i siteringsrekkefølge, slik unsrtnat gjorde.
%
% biblatex er unntaket fra hyperref-sist-regelen: den er
% skrevet for å lastes ETTER hyperref, og står derfor sist.
% ============================================================
% csquotes gir biblatex språkriktige sitattegn i
% bibliografien; biblatex ber om den når babel er lastet.
\RequirePackage{csquotes}

\RequirePackage[backend=biber,style=numeric-comp,sorting=none]{biblatex}


