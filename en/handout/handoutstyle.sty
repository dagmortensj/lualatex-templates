\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{handoutstyle}[2026/08/26 v1.3 Handout style — calm classic typography for problem sheets]

% ============================================================
% handoutstyle.sty — handouts and problem sheets
%
% For physics and mathematics handouts: a few pages, printed
% and handed out. Same family as the notes and book styles,
% but lighter — quiet headings, no table of contents, no
% bibliography. Add natbib and a .bib file if a handout ever
% needs one.
%
% Everything about how the handout looks is set here;
% main.tex holds the content and any extra packages.
%
% Engine: LuaLaTeX. The font is OpenType and loads through
% unicode-math, which pdflatex cannot do.
%
% Order below: fonts, geometry, spacing, sectioning, page
% furniture, colours, structured environments, listings,
% hyperref last.
% ============================================================


% ============================================================
% FONT & MICROTYPOGRAPHY
%
% NewComputerModern, text and mathematics from one family.
% It is Computer Modern redrawn with more weight on the
% page, which survives laser printing where Latin Modern
% goes thin — and a handout is nearly always printed. The
% package gives you the Book weight by default; [regular]
% would bring back the thinner original.
%
% It loads unicode-math itself, so there is no separate
% \setmathfont here. Bold maths is \symbf, \symbfit,
% \symbfup — \bm and \boldmath belong to pdflatex and do not
% work here. See the README.
%
% protrusion hangs punctuation into the margin, expansion
% stretches glyphs by fractions of a percent to avoid loose
% lines, and tracking letterspaces the small caps in the
% title block.
% ============================================================
\RequirePackage{newcomputermodern}

\RequirePackage[
  expansion=true,
  protrusion=true,
  tracking=true
]{microtype}


% ============================================================
% PAGE GEOMETRY (A4, SYMMETRIC)
%
% 3 cm all round gives a 150 mm measure. At 11pt that is
% 3.06 lowercase alphabets — wider than the 1.8–2.4 window
% Bringhurst gives for continuous prose. A handout is mostly
% problems and displayed equations rather than continuous
% prose, and those want the width; the leading below is
% opened slightly to compensate.
%
% Widen the margins to 4 cm for a 130 mm measure (2.65) if a
% handout turns out to be mostly text.
% ============================================================
\RequirePackage[
  a4paper,
  left=3.0cm,
  right=3.0cm,
  top=2.6cm,
  bottom=3.0cm
]{geometry}


% ============================================================
% PARAGRAPHS & LEADING
%
% Indented paragraphs with no space between them, as in a
% book. \setstretch{1.04} takes the baseline from 13.6pt to
% 14.14pt — a little less open than the notes style, which
% suits a shorter document.
% ============================================================
\setlength{\parindent}{15pt}
\setlength{\parskip}{0pt}

\RequirePackage{setspace}
\setstretch{1.04}


% ============================================================
% DISPLAYED EQUATION SPACING
%
% A notch tighter than the book and notes styles, to suit a
% document of a few pages.
%
%   above  10pt     after a short lead-in line   6pt
%   below  10pt     always                      10pt
%
% Only the space above shrinks after a short line, since a
% short line already leaves air of its own — and it never
% shrinks to zero, which is the cramped look the class
% default (0pt) produces. The space below is always full, so
% the gap under an equation never depends on what came
% before.
%
% \AtBeginDocument is not decoration. \begin{document} runs
% \normalsize, which resets all four skips to the class
% defaults, so values set in the preamble are silently
% discarded.
% ============================================================
\AtBeginDocument{%
  \setlength{\abovedisplayskip}{10pt plus 3pt minus 2pt}%
  \setlength{\belowdisplayskip}{10pt plus 3pt minus 2pt}%
  \setlength{\abovedisplayshortskip}{6pt plus 2pt minus 2pt}%
  \setlength{\belowdisplayshortskip}{10pt plus 3pt minus 2pt}%
}


% ============================================================
% CAPTIONS
%
%   font=small       one step below body text
%   labelfont=bf     bold "Figure 1." label
%   labelsep=period  a period after the number, not a colon
%
% Single-line captions centre themselves; longer ones are
% justified. Both are caption's defaults.
% ============================================================
\RequirePackage[font=small,labelfont=bf,labelsep=period]{caption}


% ============================================================
% SECTION HEADINGS
%
% Two levels, bold upright, with no rules and no display
% sizes:
%
%   section      \large       one step above body
%   subsection   \normalsize  body size
%
% One size step is the whole hierarchy — on a two-page
% handout anything more reads as shouting. The space above a
% heading does the rest of the work. The second level is
% there so the same style can carry lecture notes.
% ============================================================
\RequirePackage{titlesec}

% Sections
\titleformat{\section}
  {\normalfont\large\bfseries}
  {\thesection}{0.6em}{}

\titlespacing*{\section}
  {0pt}
  {6ex plus 2ex minus .8ex}
  {2ex plus .5ex}

% Subsections: smaller than sections but not below body size
\titleformat{\subsection}
  {\normalfont\normalsize\bfseries}
  {\thesubsection}{0.6em}{}

\titlespacing*{\subsection}
  {0pt}
  {3.5ex plus 1ex minus .5ex}
  {1.2ex plus .3ex}


% ============================================================
% PAGE STYLE
%
% No running headers; page number centred at the foot. To
% drop the number entirely you need both \pagestyle{empty}
% and \thispagestyle{empty} after \maketitle — see main.tex.
% ============================================================
\pagestyle{plain}


% ============================================================
% TITLE BLOCK
%
%   \title{...}  \date{...}
%   \maketitle
%
% Title and date centred in letterspaced small caps, no
% author line — a handout is usually identified by its
% course, which belongs in \date. \lsstyle is microtype's
% tracking, which is why microtype is loaded with
% tracking=true above.
% ============================================================
\makeatletter
\renewcommand{\maketitle}{%
  \thispagestyle{plain}
  \begin{center}
    \vspace*{1em}
    {\Large\normalfont\scshape\lsstyle \@title\par}
    \vspace{1.6em}
    {\footnotesize\normalfont\scshape \@date\par}
    \vspace{3em}
  \end{center}
}
\makeatother


% ============================================================
% COLOURS
%
% Three colours with fixed roles, so a document never has to
% invent one:
%
%   darkred      hyperlinks, footnote rule, \separator
%   darkorange   figures: strokes, nodes, filled areas
%   darkolive    figures: a second colour for curves, fills
%
% Keep darkred out of figures — it reads as structure, not
% content. Black and grey are available for axes and
% secondary labels.
% ============================================================
\RequirePackage{xcolor}
\definecolor{darkred}   {RGB}{120, 20,  20}
\definecolor{darkorange}{RGB}{184, 92,   0}
\definecolor{darkolive} {RGB}{ 74,107,  18}


% ============================================================
% THEOREM-LIKE ENVIRONMENTS
%
%   \begin{theorem} ... \end{theorem}
%   \begin{definition} ... \end{definition}
%   \begin{remark} ... \end{remark}
%
% All three share one counter, scoped to the section:
% Theorem 1.1, Definition 1.2, Remark 1.3. Add more with
% \newtheorem{lemma}[theorem]{Lemma} in main.tex to keep
% them in the same sequence.
%
% The labels are \providecommand, so they can be replaced
% before this style is loaded:
%   \providecommand{\theoremname}{Teorem}
%
% amsthm is loaded once here; the exercise environment
% further down uses it too.
% ============================================================
\RequirePackage{amsthm}

\providecommand{\theoremname}{Theorem}
\providecommand{\definitionname}{Definition}
\providecommand{\remarkname}{Remark}

% --- Space around them ---
% amsthm's default is \topsep, tight enough that a theorem
% crowds the prose around it. \thm@space@setup raises it and
% equalises above and below. Only vertical space is touched:
% fonts, head format and indentation stay as amsthm sets
% them.
%
% amsthm's 'remark' style then halves whatever it inherits.
% \th@remark is redefined to drop just that halving — the
% italic head and upright body are kept — so a remark sits
% in the page like a theorem does.
\makeatletter
\def\thm@space@setup{%
  \setlength\thm@preskip{2.8ex plus 1ex minus .4ex}%
  \setlength\thm@postskip{\thm@preskip}%
}
\def\th@remark{\thm@headfont{\itshape}\normalfont}
\makeatother

\theoremstyle{plain}
\newtheorem{theorem}{\theoremname}[section]

\theoremstyle{definition}
\newtheorem{definition}[theorem]{\definitionname}

\theoremstyle{remark}
\newtheorem{remark}[theorem]{\remarkname}


% ============================================================
% SEPARATOR RULE
%
%   \separator
%
% A short dark red rule with air on both sides, for a topic
% shift inside a section, or between examples and after
% exercises. It is quieter than a heading, which is the
% point: it marks a break without claiming a level in the
% hierarchy.
%
% It borrows the footnote rule's width, saved here as
% \orig@footnoterule before hyperref can redefine
% \footnoterule further down. The leading \par closes any
% open paragraph, so \separator is safe directly after
% running text.
% ============================================================
\makeatletter
\let\orig@footnoterule\footnoterule
\newcommand{\separator}{%
  \par
  \vspace{3.5ex plus 1.5ex minus .5ex}
  {\color{darkred}\orig@footnoterule}
  \vspace{1.2ex}
}
\makeatother


% ============================================================
% EXERCISES
%
%   \begin{exercise}[Optional title]
%   Prompt.
%   \begin{subproblems}
%     \item First part.
%     \item Second part.
%   \end{subproblems}
%   \end{exercise}
%
% Numbered per section and counted separately from theorems,
% so Exercise 1.1 can sit next to Theorem 1.4. With a title
% the head reads "Exercise 1.1 - Title". The body sits in a
% quote environment, so it is indented from the prose.
%
% Rename the label before loading this style:
%   \providecommand{\exercisename}{Problem}
%
% Shared with the notes style, so a set of problems can move
% between the two unchanged.
% ============================================================
\newtheoremstyle{handoutex}
  {1ex}              % space above
  {1ex}              % space below
  {\normalfont}      % body font
  {0pt}              % indent
  {\bfseries}        % head font
  {}                 % head punctuation
  {\newline}         % space between head and body
  {\thmname{#1}\thmnumber{ #2}\thmnote{ - \bfseries#3}}

\providecommand{\exercisename}{Exercise}

\theoremstyle{handoutex}
\newtheorem{exerciseinner}{\exercisename}[section]
\renewcommand{\theexerciseinner}{\thesection.\arabic{exerciseinner}}

% Back to amsthm's default, so a \newtheorem added later in
% main.tex starts from 'plain' and not from the exercise
% style.
\theoremstyle{plain}

% The {\newline} separator above puts the body on its own
% line under the bold label; \leavevmode\par\vspace{-2ex}
% then pulls it back up to a tight gap. -2ex is
% font-relative, so it tracks the line height across sizes.
\newenvironment{exercise}[1][]
{%
  \par
  \begin{quote}
  \def\tmp{#1}\ifx\tmp\empty
    \begin{exerciseinner}\leavevmode\par\vspace{-2ex}
  \else
    \begin{exerciseinner}[#1]\leavevmode\par\vspace{-2ex}
  \fi
}
{%
  \end{exerciseinner}
  \end{quote}
  \vspace{3.5ex plus 1.5ex minus .8ex}
}


% ============================================================
% SUBPROBLEMS — a), b), c)
%
% Its own list rather than a global \setlist, so ordinary
% enumerate lists elsewhere keep their default numbering.
% Write explanatory prose between parts as normal text
% outside the environment and pick the letters up again with
% \begin{subproblems}[resume].
% ============================================================
\RequirePackage{enumitem}

% \newlist{<name>}{<type>}{<max depth>}
\newlist{subproblems}{enumerate}{1}

\setlist[subproblems]{%
  label=\alph*),
  leftmargin=2.2em,
  labelsep=0.6em,
  itemsep=0.8ex,
  parsep=0.8ex,
  topsep=0.8ex
}


% ============================================================
% CODE LISTINGS
%
%   \begin{python}
%   def f(x):
%       return x**2
%   \end{python}
%
% Python with Gruvbox Light highlighting, line numbers, and
% a rule above and below. listings does the parsing, so
% there is no shell-escape and no external tool — the
% document compiles anywhere.
%
% æ, ø and å are mapped explicitly at the bottom of the
% style: listings reads its input bytewise and would
% otherwise drop them from code comments.
%
% Gruvbox Light Hard (gruvbox.dayle.io):
%   background  #fdfcf2   foreground  #3c3836
%   keywords    #9d0006   strings     #79740e
%   comments    #928374   numbers     #b57614
% ============================================================
\RequirePackage{listings}

\definecolor{gruvbg}    {HTML}{fdfcf2}
\definecolor{gruvfg}    {HTML}{3c3836}
\definecolor{gruvkw}    {HTML}{9d0006}
\definecolor{gruvstr}   {HTML}{79740e}
\definecolor{gruvcom}   {HTML}{928374}
\definecolor{gruvnum}   {HTML}{b57614}
\definecolor{gruvbi}    {HTML}{076678}

\lstdefinestyle{gruvboxlight}{
  backgroundcolor   = \color{gruvbg},
  basicstyle        = \small\ttfamily\color{gruvfg},
  keywordstyle      = \color{gruvkw}\bfseries,
  stringstyle       = \color{gruvstr},
  commentstyle      = \color{gruvcom}\itshape,
  numberstyle       = \color{gruvnum},
  identifierstyle   = \color{gruvfg},
  breaklines        = true,
  showstringspaces  = false,
  numbers           = left,
  numbersep         = 10pt,
  frame             = tb,
  xleftmargin       = 2em,
  xrightmargin      = 0em,
  framexleftmargin  = 2em,
  framexrightmargin = 0em,
  aboveskip         = 2.4ex,
  belowskip         = 2.4ex,
  extendedchars     = true,
  inputencoding     = utf8,
  literate          =
    {æ}{{\ae}}1 {ø}{{\o}}1 {å}{{\aa}}1
    {Æ}{{\AE}}1 {Ø}{{\O}}1 {Å}{{\AA}}1
}

\lstnewenvironment{python}
  {\lstset{language=Python, style=gruvboxlight,
           morekeywords={True,False,None,self}}}
  {}


% ============================================================
% HYPERLINKS
%
% Loaded last, because hyperref patches commands that other
% packages define. Dark red rather than the default blue: it
% stays legible when the handout is photocopied. Set
% \hypersetup{hidelinks} in main.tex for no colour at all.
% ============================================================
\RequirePackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=darkred,
  citecolor=darkred,
  urlcolor=darkred
}

% ============================================================
% END OF FILE
% ============================================================
\endinput
