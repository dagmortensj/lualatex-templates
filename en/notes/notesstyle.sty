\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{notesstyle}[2026/09/01 v1.9 Notes style — CUP-inspired book typography in article form]

% ============================================================
% notesstyle.sty — long-form notes
%
% For theoretical physics and mathematics notes at article
% length: too long for a handout, not a monograph. It takes
% the book style's typography into article format and adds a
% framed table of contents, theorem and exercise
% environments, and syntax-highlighted Python.
%
% Everything about how the notes look is set here; main.tex
% holds the content and any extra packages.
%
% Engine: LuaLaTeX. The font is OpenType and loads through
% unicode-math, which pdflatex cannot do.
%
% Order below: language, fonts, colours, geometry, spacing,
% sectioning with swallow rule, page furniture, structured
% environments, emphasis boxes, hyperref, citations last.
% ============================================================


% ============================================================
% LANGUAGE
%
% babel is loaded here and not in main.tex, so that loading
% the style is enough to get hyphenation and punctuation
% right. Switch language on the line below.
% ============================================================
\RequirePackage[english]{babel}


% ============================================================
% FONT & MICROTYPOGRAPHY
%
% NewComputerModern, text and mathematics from one family.
% It is Computer Modern redrawn with more weight on the
% page, which survives laser printing where Latin Modern
% goes thin. The package gives you the Book weight by
% default; [regular] would bring back the thinner original.
%
% It loads unicode-math itself, so there is no separate
% \setmathfont here. Bold maths is \symbf, \symbfit,
% \symbfup — \bm and \boldmath belong to pdflatex and do not
% work here. See the README.
%
% protrusion hangs punctuation into the margin, expansion
% stretches glyphs by fractions of a percent to avoid loose
% lines, and tracking letterspaces small caps.
% ============================================================
\RequirePackage{newcomputermodern}

\RequirePackage[
  expansion=true,
  protrusion=true,
  tracking=true
]{microtype}


% ============================================================
% COLOURS
%
% Three colours with fixed roles, so a document never has to
% invent one:
%
%   darkred      hyperlinks, footnote rule, \separator
%   darkorange   figures: strokes, nodes, filled areas
%   darkolive    figures: a second colour for curves, fills
%
% Keep darkred out of figures — it reads as structure, not
% content. Black and grey are available for axes and
% secondary labels.
%
% Defined early so darkred exists by the time \separator and
% hyperref want it.
% ============================================================
\RequirePackage{xcolor}
\definecolor{darkred}   {RGB}{120, 20,  20}
\definecolor{darkorange}{RGB}{184, 92,   0}
\definecolor{darkolive} {RGB}{ 74,107,  18}


% ============================================================
% PAGE GEOMETRY (A4, SYMMETRIC)
%
% 3 cm all round gives a 150 mm measure. At 11pt that is
% 3.06 lowercase alphabets — wider than the 1.8–2.4 window
% Bringhurst gives for continuous prose, and wider than the
% book template's 2.36. That is the usual trade for notes:
% displayed equations and long derivations want the width
% more than the prose wants short lines, and the leading
% below is opened a little to compensate.
%
% Widen the margins to 4 cm for a 130 mm measure (2.65) if a
% document turns out to be mostly text.
% ============================================================
\RequirePackage[
  a4paper,
  left=3.0cm,
  right=3.0cm,
  top=2.7cm,
  bottom=3.0cm
]{geometry}


% ============================================================
% PARAGRAPHS & LEADING
%
% Indented paragraphs with no space between them, as in a
% book. \setstretch{1.07} takes the baseline from 13.6pt to
% 14.55pt — the compensation for the long measure above.
% ============================================================
\setlength{\parindent}{15pt}
\setlength{\parskip}{0pt}

\RequirePackage{setspace}
\setstretch{1.07}


% ============================================================
% DISPLAYED EQUATION SPACING
%
% Shared with the book style, so the two read as a family.
%
%   above  12pt     after a short lead-in line   7pt
%   below  12pt     always                      12pt
%
% Only the space above shrinks after a short line, since a
% short line already leaves air of its own — and it never
% shrinks to zero, which is the cramped look the class
% default (0pt) produces. The space below is always full, so
% the gap under an equation never depends on what came
% before.
%
% \AtBeginDocument is not decoration. \begin{document} runs
% \normalsize, which resets all four skips to the class
% defaults, so values set in the preamble are silently
% discarded. Later size changes are grouped and restore
% these on exit.
% ============================================================
\AtBeginDocument{%
  \setlength{\abovedisplayskip}{12pt plus 3pt minus 3pt}%
  \setlength{\belowdisplayskip}{12pt plus 3pt minus 3pt}%
  \setlength{\abovedisplayshortskip}{7pt plus 3pt minus 3pt}%
  \setlength{\belowdisplayshortskip}{12pt plus 3pt minus 3pt}%
}


% ============================================================
% CAPTIONS
%
%   font=small       one step below body text
%   labelfont=bf     bold "Figure 1." label
%   labelsep=period  a period after the number, not a colon
%
% Single-line captions centre themselves; longer ones are
% justified. Both are caption's defaults.
% ============================================================
\RequirePackage[font=small,labelfont=bf,labelsep=period]{caption}


% ============================================================
% SECTIONING
%
% Three levels, all bold upright — small caps are reserved
% for the title block. Size and weight carry the hierarchy;
% there are no rules or colour.
%
% Subsections and above are numbered and listed in the
% contents. Subsubsections are numbered but stay out of it:
% they are a run-in level (see below), meant to label a step
% inside a derivation rather than to structure the document.
% ============================================================
\RequirePackage{titlesec}

% Sections
\titleformat{\section}
  {\normalfont\Large\bfseries}
  {\thesection}{0.8em}{}

\titlespacing*{\section}
  {0pt}{4.5ex plus 1.5ex minus .5ex}{2.4ex plus .4ex}

% Subsections
\titleformat{\subsection}
  {\normalfont\large\bfseries}
  {\thesubsection}{0.8em}{}

\titlespacing*{\subsection}
  {0pt}{4.0ex plus 1.2ex minus .4ex}{1.8ex plus .4ex}

% Subsubsections are run-in: the title begins the paragraph
% and the text follows on the same line. That is as deep as
% the hierarchy goes — anything finer wants a new section.
\titleformat{\subsubsection}[runin]
  {\normalfont\normalsize\bfseries}
  {\thesubsubsection}{0.5em}{}

\titlespacing*{\subsubsection}
  {0pt}{2.2ex plus .6ex minus .2ex}{0.6em}

% Numbered down to subsubsection, listed down to subsection.
\setcounter{tocdepth}{2}


% ============================================================
% HEADINGS SWALLOW BLOCK SPACE
%
% titlesec inserts the space above a heading with \vspace, not
% \addvspace, so it stacks on top of whatever an exercise or
% theorem leaves behind — and the transition looks like a hole.
% This hook runs before every heading: it collects trailing
% vertical glue and reinserts only what exceeds the heading's
% own space. The result is a maximum, not a sum — the same
% semantics as \addvspace. The excess goes in as \kern, not
% glue: titlesec absorbs preceding glue into its own space,
% and a kern cannot be absorbed — yet is discarded cleanly at
% a page break.
%
% Known residue: a theorem that ends a section leaves its glue
% behind a penalty in LaTeX's maintenance list, from where it
% cannot be removed. The theorem->heading transition therefore
% comes out one postskip (2.8ex) too large — mild, and older
% than this style. Exercises are unaffected: their glue is
% contributed last.
% ============================================================
\makeatletter
\newcommand{\headingswallow}[1]{%
  \par
  \@tempskipb\z@skip
  \@whiledim\lastskip>\z@\do{%
    \advance\@tempskipb\lastskip
    \removelastskip}%
  \ifdim\@tempskipb>#1\relax
    \kern\dimexpr\@tempskipb-#1\relax
  \fi}
\makeatother
\AddToHook{cmd/section/before}{\headingswallow{4.5ex}}
\AddToHook{cmd/subsection/before}{\headingswallow{4.0ex}}


% ============================================================
% PAGE STYLE
%
% No running headers; page number centred at the foot.
% ============================================================
\pagestyle{plain}


% ============================================================
% TITLE BLOCK
%
%   \title{...}  \author{...}  \date{...}
%   \maketitle
%
% Title in large small caps, a fifth of the way down the
% page, author and date below. \thanks footnotes on this
% page are marked with symbols (*, †, ‡) rather than
% numbers, so they do not disturb the footnote count in the
% body.
% ============================================================
\makeatletter
\renewcommand{\maketitle}{%
  \thispagestyle{plain}
  \vspace*{0.22\textheight}
  \begingroup
    % Title-page footnotes (\thanks) use symbols: *, \dag, \ddag, ...
    \renewcommand\thefootnote{\@fnsymbol\c@footnote}%
    \begin{center}
      {\huge\scshape \@title \par}
      \vspace{2.8em}
      {\large \@author \par}
      \vspace{0.7em}
      {\normalsize \@date \par}
    \end{center}
    \@thanks
  \endgroup
  \vspace{4.5em}%
  \setcounter{footnote}{0}%
  \global\let\@thanks\@empty
}
\makeatother


% ============================================================
% ABSTRACT
%
%   \begin{abstract} ... \end{abstract}
%
% A bold centred label over a block set to 88% of the
% measure, with the leading returned to single. The
% narrower block is what marks it as apart from the body;
% the label alone would not.
% ============================================================
\makeatletter
\renewenvironment{abstract}{%
  \par
  \centering
  {\small\bfseries \abstractname\par}
  \vspace{10pt}
  \begin{minipage}{0.88\textwidth}
    \small
    \setstretch{1.0}
}{%
  \end{minipage}
  \par
  \vspace{2.2em}
}
\makeatother


% ============================================================
% TABLE OF CONTENTS
%
%   \framedtoc
%
% A rule above the "Contents" title and another below the
% last entry, JHEP style, with no dot leaders:
%
%   ------------------------------
%   Contents
%   1  Section .................. 2
%   ------------------------------
%
% Plain \tableofcontents still works if you want it
% unframed. main.tex puts \framedtoc on its own page.
% ============================================================
\RequirePackage{tocloft}

% No dot leaders
\renewcommand{\cftsecleader}{\hfill}
\renewcommand{\cftsubsecleader}{\hfill}

% Optional width tuning (safe defaults)
\setlength{\cftsecnumwidth}{2.5em}
\setlength{\cftsubsecnumwidth}{3.0em}

% \tableofcontents is deliberately NOT redefined: wrapping it
% races with hyperref's own setup of the coloured contents
% links. \framedtoc instead calls the fully initialised
% \tableofcontents at use time. The rules are \rule boxes,
% not \hrule — a bare \hrule before the title is dropped.
\newlength{\tocrulewidth}
\setlength{\tocrulewidth}{0.4pt}

\newcommand{\framedtoc}{%
  \noindent\rule{\linewidth}{\tocrulewidth}\par
  \vspace{1.0ex}%
  \tableofcontents
  \par\vspace{1.0ex}%
  \noindent\rule{\linewidth}{\tocrulewidth}\par
}


% ============================================================
% THEOREM-LIKE ENVIRONMENTS
%
%   \begin{theorem} ... \end{theorem}
%   \begin{definition} ... \end{definition}
%   \begin{remark} ... \end{remark}
%
% All three share one counter, scoped to the section:
% Theorem 2.1, Definition 2.2, Remark 2.3. Add more with
% \newtheorem{lemma}[theorem]{Lemma} in main.tex to keep
% them in the same sequence.
%
% amsthm is loaded once here; the exercise environment
% further down uses it too.
% ============================================================
\RequirePackage{amsthm}

% --- Space around them ---
% amsthm's default is \topsep, tight enough that a theorem
% crowds the prose around it. \thm@space@setup raises it and
% equalises above and below. Only vertical space is touched:
% fonts, head format and indentation stay as amsthm sets
% them.
%
% amsthm's 'remark' style then halves whatever it inherits.
% \th@remark is redefined to drop just that halving — the
% italic head and upright body are kept — so a remark sits
% in the page like a theorem does.
\makeatletter
\def\thm@space@setup{%
  \setlength\thm@preskip{2.8ex plus 1ex minus .4ex}%
  \setlength\thm@postskip{\thm@preskip}%
}
\def\th@remark{\thm@headfont{\itshape}\normalfont}
\makeatother

\theoremstyle{plain}
\newtheorem{theorem}{Theorem}[section]

\theoremstyle{definition}
\newtheorem{definition}[theorem]{Definition}

\theoremstyle{remark}
\newtheorem{remark}[theorem]{Remark}


% ============================================================
% SEPARATOR RULE
%
%   \separator
%
% A short dark red rule with air on both sides, for a topic
% shift inside a section, or between examples and after
% exercises. It is quieter than a heading, which is the
% point: it marks a break without claiming a level in the
% hierarchy.
%
% It borrows the footnote rule's width, saved here as
% \orig@footnoterule before hyperref can redefine
% \footnoterule further down. The leading \par closes any
% open paragraph, so \separator is safe directly after
% running text.
% ============================================================
\makeatletter
\let\orig@footnoterule\footnoterule
\newcommand{\separator}{%
  \par
  \vspace{3.5ex plus 1.5ex minus .5ex}
  {\color{darkred}\orig@footnoterule}
  \vspace{1.2ex}
}
\makeatother


% ============================================================
% EXERCISES
%
%   \begin{exercise}[Optional title]
%   Prompt.
%   \begin{subproblems}
%     \item First part.
%     \item Second part.
%   \end{subproblems}
%   \end{exercise}
%
% Numbered per section and counted separately from theorems,
% so Exercise 2.1 can sit next to Theorem 2.4. With a title
% the head reads "Exercise 2.1 - Title".
%
% Shared with the handout style, so a set of problems can
% move between the two unchanged. amsthm comes from the
% theorem section above; enumitem drives the subproblems.
% ============================================================
\RequirePackage{enumitem}

% --- Exercise environment ---
\newtheoremstyle{notesex}
  {1ex}              % space above
  {1ex}              % space below
  {\normalfont}      % body font
  {0pt}              % indent
  {\bfseries}        % head font
  {}                 % head punctuation
  {\newline}         % space between head and body
  {\thmname{#1}\thmnumber{ #2}\thmnote{ - \bfseries#3}}

\theoremstyle{notesex}
\newtheorem{exerciseinner}{Exercise}[section]
\renewcommand{\theexerciseinner}{\thesection.\arabic{exerciseinner}}

% Back to amsthm's default, so a \newtheorem added later in
% main.tex starts from 'plain' and not from the exercise
% style.
\theoremstyle{plain}

% The {\newline} separator above puts the body on its own
% line under the bold label; \leavevmode\par\vspace{-2ex}
% then pulls it back up to a tight gap. -2ex is
% font-relative, so it tracks the line height across sizes.
%
% Space: 4.5ex before and 6.75ex after — one base value and
% one ratio (1.5), placed on the family's ex scale between
% the separator (3.5) and the heading space. Less room before
% ties the exercise to its lead-in prose; more room after
% marks the unit as finished. \addvspace takes the maximum of
% adjacent spaces, so two consecutive exercises get 6.75ex by
% themselves. \parindent is zeroed throughout the body, as in
% the old quote form, so subproblems read as indented.
\newenvironment{exercise}[1][]
{%
  \par\addvspace{4.5ex plus 1.5ex minus .8ex}
  \setlength{\parindent}{0pt}%
  \boxzerothmspace
  \def\tmp{#1}\ifx\tmp\empty
    \begin{exerciseinner}\leavevmode\par\vspace{-2ex}
  \else
    \begin{exerciseinner}[#1]\leavevmode\par\vspace{-2ex}
  \fi
}
{%
  \end{exerciseinner}
  \par\addvspace{6.75ex plus 2.2ex minus 1.2ex}
}

% --- Subproblems: a), b), c) ---
%
% Its own list rather than a global \setlist, so ordinary
% enumerate lists elsewhere keep their default numbering.
% Write explanatory prose between parts as normal text
% outside the environment and pick the letters up again with
% \begin{subproblems}[resume].
%
% The labels are bold, echoing the bold exercise head, and
% the indent is \leftmargini — the same left edge as ordinary
% enumerate and itemize lists, so every list in a document
% shares one grid.
\newlist{subproblems}{enumerate}{1}
\setlist[subproblems]{%
  label=\textbf{\alph*)},
  leftmargin=\leftmargini,
  labelsep=0.6em,
  itemsep=0.8ex,
  parsep=0.8ex,
  topsep=0.8ex
}


% ============================================================
% CODE LISTINGS
%
%   \begin{python}
%   def f(x):
%       return x**2
%   \end{python}
%
% Python with Gruvbox Light highlighting, line numbers, and
% a rule above and below. listings does the parsing, so
% there is no shell-escape and no external tool — the
% document compiles anywhere.
%
% æ, ø and å are mapped explicitly at the bottom of the
% style: listings reads its input bytewise and would
% otherwise drop them from code comments.
%
% Gruvbox Light Hard (gruvbox.dayle.io):
%   background  #fdfcf2   foreground  #3c3836
%   keywords    #9d0006   strings     #79740e
%   comments    #928374   numbers     #b57614
% ============================================================
\RequirePackage{listings}

\definecolor{gruvbg}    {HTML}{fdfcf2}
\definecolor{gruvfg}    {HTML}{3c3836}
\definecolor{gruvkw}    {HTML}{9d0006}
\definecolor{gruvstr}   {HTML}{79740e}
\definecolor{gruvcom}   {HTML}{928374}
\definecolor{gruvnum}   {HTML}{b57614}
\definecolor{gruvbi}    {HTML}{076678}

\lstdefinestyle{gruvboxlight}{
  backgroundcolor   = \color{gruvbg},
  basicstyle        = \small\ttfamily\color{gruvfg},
  keywordstyle      = \color{gruvkw}\bfseries,
  stringstyle       = \color{gruvstr},
  commentstyle      = \color{gruvcom}\itshape,
  numberstyle       = \color{gruvnum},
  identifierstyle   = \color{gruvfg},
  breaklines        = true,
  showstringspaces  = false,
  numbers           = left,
  numbersep         = 10pt,
  frame             = tb,
  xleftmargin       = 2em,
  xrightmargin      = 0em,
  framexleftmargin  = 2em,
  framexrightmargin = 0em,
  aboveskip         = 2.4ex,
  belowskip         = 2.4ex,
  extendedchars     = true,
  inputencoding     = utf8,
  literate          =
    {æ}{{\ae}}1 {ø}{{\o}}1 {å}{{\aa}}1
    {Æ}{{\AE}}1 {Ø}{{\O}}1 {Å}{{\AA}}1
}

\lstnewenvironment{python}
  {\lstset{language=Python, style=gruvboxlight,
           morekeywords={True,False,None,self}}}
  {}


% ============================================================
% VECTOR ARROWS (esvect)
%
% main.tex loads esvect when a document wants \vv arrows; the
% style carries only the size fix the package needs under
% unicode-math. esvect's own font definition lists exact sizes
% (5, 6, ..., 10 pt), while unicode-math asks for fractional
% maths sizes -- NewCM's scriptscript is 0.50 x 10.95 =
% 5.475 pt -- and LaTeX substitutes silently only within
% 0.4 pt; without the fix the arrows in subscripts come out
% about 9 % too small, with a warning. Continuous ranges cover
% every size -- the same fix the overarrows author adopted
% upstream. Guarded, so it does nothing in a document that
% never loads esvect.
% ============================================================
\AtBeginDocument{%
  \IfPackageLoadedTF{esvect}{%
    \DeclareFontFamily{U}{esvect}{}%
    \DeclareFontShape{U}{esvect}{m}{n}{%
      <-5.5>    vect5
      <5.5-6.5> vect6
      <6.5-7.5> vect7
      <7.5-8.5> vect8
      <8.5-9.5> vect9
      <9.5->    vect10
    }{}%
  }{}%
}


% ============================================================
% EMPHASIS BOXES
%
%   \begin{important}
%     \begin{definition} ... \end{definition}
%   \end{important}
%
%   \begin{mainresult}[Law of gravitation]   % title optional
%     \begin{theorem} ... \end{theorem}
%   \end{mainresult}
%
% Two wrappers for what deserves lifting out of the prose.
% important sets thin dark red rules above and below — the
% same weight as the separator rule — and is meant around
% important definitions. mainresult sets a hairline frame
% around the document's central result; with the optional
% argument the title sits in letterspaced small caps
% breaking the top frame rule, the way old reference works
% set titles, and without it the frame stands clean.
%
% Both are wrappers, not theorem types of their own: the
% counter and numbering belong to the environment inside,
% so a boxed definition sits in the same sequence as an
% unboxed one — and unnumbered mode follows along by
% itself. Use them sparingly: box everything and the box is
% no longer a signal.
%
% The boxes break across pages. The theorem environments'
% own space above and below is zeroed inside the box — it
% is sized against prose, and on top of the box padding it
% would double up. \thm@space@setup is run by amsthm at
% every environment start, so a local redefinition inside
% the box group suffices.
% ============================================================
\RequirePackage[skins,breakable]{tcolorbox}

\makeatletter
\newcommand{\boxzerothmspace}{%
  \def\thm@space@setup{%
    \setlength\thm@preskip{\z@}%
    \setlength\thm@postskip{\z@}}}
\makeatother

\tcbset{boxbase/.style={
  enhanced, breakable, sharp corners,
  boxrule=0pt, frame hidden, colback=white,
  left=0pt, right=0pt, top=1.6ex, bottom=1.6ex,
  before skip=3.2ex plus 1ex minus .4ex,
  after skip=3.2ex plus 1ex minus .4ex,
  parbox=false,
  before upper=\boxzerothmspace
}}

\newtcolorbox{important}{boxbase,
  borderline north={0.5pt}{0pt}{darkred},
  borderline south={0.5pt}{0pt}{darkred}
}

\NewTColorBox{mainresult}{o}{boxbase,
  borderline={0.4pt}{0pt}{darkred},
  left=1.2em, right=1.2em, top=1.8ex, bottom=1.8ex,
  IfValueT={#1}{
    top=2.2ex,
    attach boxed title to top left=
      {xshift=1.0em, yshift=-\tcboxedtitleheight/2},
    boxed title style={colback=white, frame hidden,
      boxrule=0pt, sharp corners,
      left=0.45em, right=0.45em, top=0pt, bottom=0pt},
    title={\footnotesize\scshape\lsstyle\color{darkred}#1}
  }
}


% ============================================================
% HYPERLINKS
%
% Loaded almost last, because hyperref patches commands
% that other packages define; only biblatex comes after.
% Dark red rather than the default blue: it
% stays legible when the notes are printed in grey. Set
% \hypersetup{hidelinks} in main.tex for no colour at all.
% ============================================================
\RequirePackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=darkred,
  citecolor=darkred,
  urlcolor=darkred,
  linktoc=page
}


% ============================================================
% CITATIONS
%
%   \cite{key}            [1]
%   \cite{a,b,c}          sorted and compressed, [1-3]
%   \addbibresource{references.bib}   in the preamble of main.tex
%   \printbibliography                at the end of main.tex
%
% biblatex with biber, not natbib with bibtex — latexmk runs
% biber by itself. sorting=none lists the references in
% citation order, as unsrtnat did.
%
% biblatex is the exception to the hyperref-last rule: it is
% written to be loaded AFTER hyperref, and so sits last.
% ============================================================
% csquotes gives biblatex language-aware quotation marks
% in the bibliography; biblatex asks for it when babel is
% loaded.
\RequirePackage{csquotes}

\RequirePackage[backend=biber,style=numeric-comp,sorting=none]{biblatex}


% ============================================================
% END OF FILE
% ============================================================
\endinput
