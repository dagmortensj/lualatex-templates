% =================================================
% REFERENCES — article template
%
% Add your own references here.
% Examples of the most common types are shown below.
% Delete the examples when you no longer need them.
%
% Tips:
%  - Google Scholar has a "Cite → BibTeX" button for most articles
%  - Inspire-HEP (inspirehep.net) for physics articles
%  - arXiv pages have BibTeX export under "Export"
% =================================================


% --------------------------------------------------
% EXAMPLE: Journal article
% --------------------------------------------------
@article{example2024,
  author  = {Lastname, Firstname and Coauthor, Firstname},
  title   = {Title of the article},
  journal = {Journal of Physics A},
  year    = {2024},
  volume  = {57},
  number  = {3},
  pages   = {123--145},
  doi     = {10.1000/example}
}

% --------------------------------------------------
% EXAMPLE: Book
% --------------------------------------------------
@book{examplebook2020,
  author    = {Author, Firstname},
  title     = {Book title},
  publisher = {Cambridge University Press},
  year      = {2020},
  edition   = {2}
}

% --------------------------------------------------
% EXAMPLE: PhD thesis
% --------------------------------------------------
@phdthesis{examplephd2019,
  author = {Candidate, Firstname},
  title  = {Title of the thesis},
  school = {University of Oslo},
  year   = {2019}
}

% --------------------------------------------------
% EXAMPLE: Conference paper
% --------------------------------------------------
@inproceedings{exampleconf2023,
  author    = {Author, Firstname},
  title     = {Title of the contribution},
  booktitle = {Proceedings of the Conference on Physics},
  year      = {2023},
  pages     = {45--52}
}

% --------------------------------------------------
% EXAMPLE: Preprint / arXiv
% --------------------------------------------------
@misc{examplearxiv2024,
  author        = {Author, Firstname},
  title         = {Title of the preprint},
  year          = {2024},
  eprint        = {2401.00000},
  archivePrefix = {arXiv},
  primaryClass  = {quant-ph}
}
