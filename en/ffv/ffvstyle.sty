\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ffvstyle}[2026/09/04 v1.4 Article style — two-column]

% ============================================================
% ffvstyle.sty — a two-column article
%
% For essayistic articles in theoretical physics and
% mathematics. Everything about how the article looks is set
% here; main.tex holds only the content.
%
% Engine: LuaLaTeX. The fonts are OpenType and load through
% unicode-math, which pdflatex cannot do.
%
% Order below: language, fonts, geometry, spacing,
% sectioning, floats, page furniture, natbib, hyperref last.
% ============================================================


% ============================================================
% LANGUAGE
%
% babel is loaded here and not in main.tex, so that loading
% the style is enough to get hyphenation and punctuation
% right. Switch language on the line below.
% ============================================================
\RequirePackage[english]{babel}


% ============================================================
% NUMBERS & UNITS (siunitx)
%
% main.tex loads siunitx when a document needs \qty and
% \num; the style carries the language choices, so a
% document that loads the package gets English typesetting
% without configuring anything itself. The hook runs the
% moment siunitx is loaded -- before the rest of the
% preamble -- so a \sisetup in main.tex still overrides
% what is set here. Does nothing in a document that never
% loads siunitx.
%
% The choices follow NIST SP 811 and ISO 80000-1:
%   decimal point         6.63 (siunitx default)
%   multiplication cross  6.63 × 10^-34 -- not a half-high
%                         dot; ISO reserves the dot for the
%                         decimal-comma tradition (default)
%   "to" and "and"        \qtyrange: 10 km to 20 km,
%                         \qtylist: 1 V, 2 V and 3 V (default)
%   slash in units        m/s^2 -- not m s^-2; textbook,
%                         not journal
%   combined uncertainty  (9.81 ± 0.03) m/s^2
%
% The rest are siunitx defaults and should stay: thin space
% around the multiplication sign and between number and
% unit (as in Griffiths), digit grouping by thin space from
% five digits (10 000, but 1000), and a space before %.
% ============================================================
\AddToHook{package/siunitx/after}{%
  \sisetup{
    per-mode              = symbol,
    separate-uncertainty  = true,
  }%
}


% ============================================================
% FONTS & MICROTYPOGRAPHY
%
% STIX Two throughout, text and mathematics from one
% family — a Times-like face with a complete maths
% companion, which is what keeps symbols in running text
% from standing out against the prose.
%
% Bold maths is \symbf, \symbfit, \symbfup. They pull STIX
% Two's drawn Unicode bold alphabets out of the same file,
% so they work on Greek as well as Latin. \bm and \boldmath
% belong to pdflatex and do not work here — see the README.
%
% protrusion hangs punctuation into the margin, expansion
% stretches glyphs by fractions of a percent to avoid loose
% lines — both earn their keep in narrow columns.
% ============================================================
\RequirePackage{unicode-math}

\setmainfont{STIXTwoText}[
  Extension      = .otf,
  UprightFont    = *-Regular,
  ItalicFont     = *-Italic,
  BoldFont       = *-Bold,
  BoldItalicFont = *-BoldItalic ]

\setmathfont{STIXTwoMath-Regular.otf}

\RequirePackage[
  expansion=true,
  protrusion=true,
  tracking=true
]{microtype}


% ============================================================
% PAGE GEOMETRY (A4, TWO-COLUMN)
%
% 2 cm margins and a 7 mm gutter give two columns of
% 81.5 mm. That is a short measure by design: a narrow column
% needs less leading and tolerates more hyphenation than a
% full-width page, and it is what the two-column format buys
% you.
% ============================================================
\RequirePackage[
  a4paper,
  left=2.0cm,
  right=2.0cm,
  top=2.5cm,
  bottom=2.7cm,
  columnsep=0.7cm
]{geometry}


% ============================================================
% PARAGRAPHS & LEADING
%
% STIX Two at 10pt has a natural baseline of 12pt.
% \setstretch{1.05} takes it to about 12.6pt — enough for
% inline mathematics to sit in the column without pushing
% the prose apart.
%
% Indented paragraphs, no space between them.
% ============================================================
\setlength{\parindent}{12pt}
\setlength{\parskip}{0pt}

\RequirePackage{setspace}
\setstretch{1.05}


% ============================================================
% DISPLAYED EQUATION SPACING
%
% Tuned against the 12.6pt baseline, so displayed maths
% keeps the rhythm of the column.
%
%   above  10pt     after a short lead-in line   4pt
%   below  10pt     always                      10pt
%
% 10pt is a little under one baseline: enough for the
% equation to breathe without detaching from its sentence.
% Only the space above shrinks after a short line, since a
% short line already leaves air of its own. The space below
% is always full, so the gap under an equation never depends
% on what came before.
%
% \AtBeginDocument is not decoration. \begin{document} runs
% \normalsize, which resets all four skips to the class
% defaults, so values set in the preamble are silently
% discarded.
% ============================================================
\AtBeginDocument{%
  \setlength{\abovedisplayskip}{10pt plus 3pt minus 2pt}%
  \setlength{\belowdisplayskip}{10pt plus 3pt minus 2pt}%
  \setlength{\abovedisplayshortskip}{4pt plus 2pt minus 1pt}%
  \setlength{\belowdisplayshortskip}{10pt plus 3pt minus 2pt}%
}

% ============================================================
% ROW SPACING IN ALIGN
%
% \jot is the extra space amsmath adds between the rows of
% align, gather and aligned. The default is 3 pt, which
% crowds the rows, especially when they hold display-style
% fractions. 8 pt gives the rows about the same breathing
% room as the space to the surrounding prose, without the
% chain falling apart into separate equations; 10 pt does.
% Where one block needs less, use \\[-2pt] locally.
%
% No \AtBeginDocument needed: \jot is an ordinary length that
% \normalsize leaves alone.
% ============================================================
\setlength{\jot}{8pt}


% ============================================================
% SECTIONING
%
% Two levels, both bold upright and numbered. A narrow
% column has no room for display sizes, so the hierarchy is
% carried by one step down from body size at the subsection
% and by the space above each heading.
% ============================================================
\RequirePackage{titlesec}

% Sections: bold, slightly larger
\titleformat{\section}
  {\normalfont\normalsize\bfseries}
  {\thesection.}{0.6em}{}

\titlespacing*{\section}
  {0pt}{3.5ex plus 1.0ex minus .4ex}{1.6ex plus .3ex}

% Subsections: bold, same size as body text
\titleformat{\subsection}
  {\normalfont\small\bfseries}
  {\thesubsection.}{0.6em}{}

\titlespacing*{\subsection}
  {0pt}{3.0ex plus 0.8ex minus .3ex}{1.2ex plus .3ex}


% ============================================================
% FLOAT PARAMETERS
%
% LaTeX's defaults are cautious enough that a two-column
% article often ends up with half-empty pages. These let a
% figure claim more of the page before LaTeX gives up and
% defers it.
%
%   topfraction         most of a page top floats may take
%   bottomfraction      most of a page bottom they may take
%   textfraction        least text a mixed page must keep
%   floatpagefraction   least a float-only page must fill
%
% The dbl* versions are the same limits for figure*, which
% spans both columns.
% ============================================================
\renewcommand{\topfraction}{0.90}
\renewcommand{\bottomfraction}{0.80}
\renewcommand{\textfraction}{0.10}
\renewcommand{\floatpagefraction}{0.75}
\renewcommand{\dbltopfraction}{0.90}       % for figure* (two-column)
\renewcommand{\dblfloatpagefraction}{0.75}

% Spacing between floats and between floats and text
\setlength{\textfloatsep}{14pt plus 3pt minus 3pt}
\setlength{\floatsep}{12pt plus 3pt minus 2pt}
\setlength{\intextsep}{12pt plus 3pt minus 2pt}
\setlength{\dbltextfloatsep}{14pt plus 3pt minus 3pt}
\setlength{\dblfloatsep}{12pt plus 3pt minus 2pt}


% ============================================================
% CAPTIONS
%
%   font=small       one step below body text
%   labelfont=bf     bold "Figure 1." label
%   labelsep=period  a period after the number, not a colon
%   skip=6pt         a tighter gap, to suit the narrow column
%
% Single-line captions centre themselves; longer ones are
% justified.
% ============================================================
\RequirePackage[
  font=small,
  labelfont=bf,
  labelsep=period,
  singlelinecheck=true,
  skip=6pt
]{caption}


% ============================================================
% TABLES
%
% booktabs: \toprule, \midrule, \bottomrule, and no vertical
% rules at all. arraystretch opens the rows by 15%, which a
% ruled-only table needs to stay readable.
% ============================================================
\RequirePackage{booktabs}
\renewcommand{\arraystretch}{1.15}


% ============================================================
% GRAPHICS
%
% \includegraphics. main.tex sets \graphicspath if figures
% live in their own folder.
% ============================================================
\RequirePackage{graphicx}


% ============================================================
% PAGE STYLE
%
% No running headers; page number centred at the foot.
% ============================================================
\pagestyle{plain}


% ============================================================
% TITLE BLOCK
%
%   \twocolumn[\maketitle \begin{lead} ... \end{lead}]
%
% The title spans the full page width above the columns,
% which is what the \twocolumn[...] argument is for. Title in
% small caps, author and date below.
% ============================================================
\makeatletter
\renewcommand{\maketitle}{%
  \thispagestyle{plain}
  \begin{center}
    {\large\scshape \@title \par}
    \vspace{1.4em}
    {\normalsize \@author \par}
    \vspace{0.4em}
    {\small \@date \par}
  \end{center}
  \vspace{1.6em}
}
\makeatother


% ============================================================
% LEAD-IN PARAGRAPH
%
%   \begin{lead} ... \end{lead}
%
% A bold opening paragraph across the full page width, set
% at 92% of the measure so it reads as a block rather than a
% first paragraph. Goes immediately after \maketitle, inside
% the same \twocolumn[...] argument.
% ============================================================
\newenvironment{lead}{%
  \par
  \centering
  \begin{minipage}{0.92\linewidth}
    \small\bfseries
    \setstretch{1.05}
}{%
  \end{minipage}
  \par
  \vspace{1.8em}
}


% ============================================================
% CITATIONS
%
%   \cite{key}            [1]
%   \cite{a,b,c}          sorted and compressed, [1-3]
%   \bibliographystyle{unsrtnat}   in main.tex
%
% natbib has to come before hyperref.
% ============================================================
\RequirePackage[numbers,sort&compress]{natbib}


% ============================================================
% HYPERLINKS
%
% Loaded last, because hyperref patches commands that other
% packages define. Dark red rather than the default blue: it
% stays legible when the article is printed in grey.
% ============================================================
\RequirePackage{xcolor}
\definecolor{darkred}{RGB}{120,20,20}

\RequirePackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=darkred,
  citecolor=darkred,
  urlcolor=darkred,
  linktoc=page
}


% ============================================================
% END OF FILE
% ============================================================
\endinput
