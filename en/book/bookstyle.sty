\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bookstyle}[2026/08/31 v1.12 — frozen CUP-style book layout]

% ============================================================
% PACKAGE OPTIONS
%
%   \usepackage{bookstyle}            normal
%   \usepackage[proof]{bookstyle}     page proofs: the B5
%                                     page untouched, centred
%                                     on A4 with crop marks
%
% Proof mode requires b5paper in \documentclass. The
% typesetting is untouched, so both line and page breaks are
% identical to print — unlike the a4paper draft, which
% shares line breaks but not page breaks. With a4paper the
% option is ignored with a warning. 'korrektur' is accepted
% as a synonym.
% ============================================================
\newif\ifbk@korrektur
\DeclareOption{korrektur}{\bk@korrekturtrue}
\DeclareOption{proof}{\bk@korrekturtrue}
\ProcessOptions\relax


% ============================================================
% bookstyle.sty — a CUP-style monograph
%
% Every typographic decision lives in this file. You should
% not need to edit it to write a book: set the paper size in
% main.tex and start writing.
%
%   \documentclass[12pt,twoside,b5paper]{book}   % print
%   \documentclass[12pt,twoside,a4paper]{book}   % draft
%
% Engine: LuaLaTeX. The fonts are OpenType and load through
% unicode-math, which pdflatex cannot do.
%
% Order below: fonts, microtypography, geometry, spacing,
% sectioning, page furniture, citations, hyperref last.
% ============================================================


% ============================================================
% FONTS
%
% Garamond Libre for text, STIX Two Math for mathematics.
% STIX Two shrinks a sub-subscript to 55% where most maths
% fonts use 50%, which decides whether a tensor index is
% readable.
%
% Scale=0.90: matching x-heights exactly would call for
% 0.86. The 6% above is deliberate — displayed maths stands
% alone and carries indices that need air. Past about 0.95
% it starts to tower over the prose.
%
% Bold maths is \symbf, \symbfit, \symbfup. They pull STIX
% Two's drawn Unicode bold alphabets out of this same file,
% so they work on Greek as well as Latin. \bm and \boldmath
% belong to pdflatex and do not work here — see the README.
% ============================================================
\RequirePackage{unicode-math}

\setmainfont{GaramondLibre}[
  Extension      = .otf,
  UprightFont    = *-Regular,
  ItalicFont     = *-Italic,
  BoldFont       = *-Bold,
  BoldItalicFont = *-BoldItalic ]

\setmathfont{STIXTwoMath-Regular.otf}[Scale=0.90]


% ============================================================
% MICROTYPOGRAPHY
%
% protrusion hangs punctuation into the margin, expansion
% stretches glyphs by fractions of a percent to avoid loose
% lines, and tracking letterspaces small caps. Drop any of
% the three here if a page looks wrong.
% ============================================================
\RequirePackage[
  expansion=true,
  protrusion=true,
  tracking=true
]{microtype}


% ============================================================
% PAGE GEOMETRY
%
% MEASURE. Bringhurst measures line length in lowercase
% alphabets, and 1.8–2.4 is the usable window. Garamond
% Libre's alphabet at 12pt is 50.9 mm, so the 120 mm measure
% below is 2.36 alphabets. 126 mm would be 2.48 — too wide,
% and it would force the leading open to compensate.
%
% MARGINS. Outer wider than inner, deliberately: the two
% inner margins meet over the spine and read as one space,
% while the fore-edge is where the thumb goes. 24 mm inner
% still clears a perfect binding, and the wide fore-edge is
% where an oversized display equation can hang out.
%
% The measure, not the margins, is what stays constant when
% the paper size changes: an A4 draft breaks lines exactly
% as the printed B5 will, with 4 cm left over for notes.
% Page breaks still differ — A4 is taller.
% ============================================================
\RequirePackage{geometry}
\ifdim\paperwidth>18cm
  \geometry{inner=4.3cm, outer=4.7cm, top=2.6cm, bottom=3.9cm}
\else
  \geometry{inner=2.4cm, outer=3.2cm, top=2.6cm, bottom=3.9cm}
\fi


% Page proofs: the B5 sheet centred on A4 with crop marks
% (cam) and crop's info line at the top — add noinfo to the
% options below for a clean sheet. Loaded here, after the
% geometry is set.
\ifbk@korrektur
  \ifdim\paperwidth>18cm
    \PackageWarning{bookstyle}{The 'proof' option requires b5paper; option ignored}%
  \else
    \RequirePackage[cam,a4,center]{crop}
  \fi
\fi


% ============================================================
% PARAGRAPHS & LEADING
%
% Indented paragraphs with no space between them — the
% classical book setting.
% ============================================================
\setlength{\parindent}{15pt}
\setlength{\parskip}{0pt}

% Baseline 14.79pt on 12pt type — derived, not chosen by
% eye. A CUP monograph set Times 10.5/13 leaves 3.28pt of
% clear air between one line's descenders and the next
% line's ascenders. Garamond Libre at 12pt is the same
% optical size (x-height 4.88pt, against Times at 10.33pt)
% but its extenders run 18% longer, so it needs 14.79pt to
% leave the same 3.28pt.
%
% Baseline over x-height still lands at 3.03 against CUP's
% 2.62, so the page reads a shade more open than a Times-set
% book. That residue is the face itself — small eye, long
% extenders — and closing it would drive descenders into the
% line above.
\RequirePackage{setspace}
\setstretch{1.02}


% ============================================================
% DISPLAYED EQUATION SPACING
%
% Shared with the notes style, so the two read as a family.
%
%   above  12pt     after a short lead-in line   7pt
%   below  12pt     always                      12pt
%
% Only the space above shrinks after a short line, since a
% short line already leaves air of its own — and it never
% shrinks to zero. The space below is always full, so the
% gap under an equation never depends on what came before.
%
% \AtBeginDocument is not decoration. \begin{document} runs
% \normalsize, which resets all four skips to the class
% defaults, so values set in the preamble are silently
% discarded. Later size changes are grouped and restore
% these on exit.
% ============================================================
\AtBeginDocument{%
  \setlength{\abovedisplayskip}{12pt plus 3pt minus 3pt}%
  \setlength{\belowdisplayskip}{12pt plus 3pt minus 3pt}%
  \setlength{\abovedisplayshortskip}{7pt plus 3pt minus 3pt}%
  \setlength{\belowdisplayshortskip}{12pt plus 3pt minus 3pt}%
}


% ============================================================
% EQUATION NUMBERS
%
% amsmath sets the tag "(2.1)" in \normalfont — Garamond at
% the full 12pt — while the maths beside it is scaled to
% 0.90, an effective 10.8pt. The tag then reads ~11% too
% large. \small in the 12pt class is 10.95pt — practically
% the same scale as the maths — so the tag is set in
% \small.
%
% \eqref shares the tag form and would shrink with it. In
% running text the number sits among 12pt prose and should
% match it, so \eqref is restored to full size.
%
% amsmath is loaded in main.tex, after this file, so the
% definitions are swapped in only at \AtBeginDocument — and
% only when amsmath is actually loaded.
% ============================================================
\newcommand{\bk@smalltagform}[1]{%
  \maketag@@@{\small(\ignorespaces#1\unskip\@@italiccorr)}}
\newcommand{\bk@fulleqref}[1]{\textup{(\ref{#1})}}

\AtBeginDocument{%
  \@ifpackageloaded{amsmath}{%
    \let\tagform@\bk@smalltagform
    \let\eqref\bk@fulleqref
  }{}%
}


% ============================================================
% CAPTIONS
%
%   font=small       one step below body text
%   labelfont=bf     bold "Figure 1." label
%   labelsep=period  a period after the number, not a colon
%
% Single-line captions centre themselves; longer ones are
% justified. Both are caption's defaults.
% ============================================================
\RequirePackage[font=small,labelfont=bf,labelsep=period]{caption}


% ============================================================
% SECTIONING
%
% A chapter opens on a display page: small-caps "Chapter N"
% above the title in large uppercase. Sections and below are
% bold upright, one size step apart. \chaptername and
% \partname come from babel, so they follow the document
% language.
% ============================================================
\RequirePackage{titlesec}

% ------------------ Main chapters ----------------
\titleformat{\chapter}[display]
  {\normalfont}
  {\filcenter\scshape \chaptername\ \thechapter}
  {3ex}
  {\filcenter\Huge\MakeUppercase}

\titlespacing*{\chapter}
  {0pt}{3.5ex plus 1ex minus .2ex}{11ex plus 2ex minus .5ex}

% ------------------ Sections ---------------------
\titleformat{\section}
  {\normalfont\bfseries\large}
  {\thesection}{1em}{}

\titlespacing*{\section}
  {0pt}{2.5ex plus 1ex minus .2ex}{1.5ex plus .2ex}

% ------------------ Subsections ------------------
\titleformat{\subsection}
  {\normalfont\bfseries\normalsize}
  {\thesubsection}{1em}{}

\titlespacing*{\subsection}
  {0pt}{2ex plus .8ex minus .2ex}{1.2ex plus .2ex}


% ============================================================
% SECTION NUMBERING
%
% Parts and chapters are numbered; sections and below are
% not, though they still appear in the table of contents.
% Set secnumdepth to 2 if you want numbered sections.
% ============================================================
\setcounter{secnumdepth}{0}


% ============================================================
% PART PAGES
%
% A part title alone on an unnumbered page, set a third of
% the way down — the same rhythm as the chapter openings and
% the title page.
% ============================================================
\titleformat{\part}[display]
  {\normalfont}
  {\filcenter\scshape \partname\ \thepart}
  {3ex}
  {\filcenter\LARGE\MakeUppercase}

\titlespacing*{\part}
  {0pt}{0.35\textheight}{0.35\textheight}

\assignpagestyle{\part}{empty}


% ============================================================
% CHAPTER OPENING DROP CAP
%
%   \chapter{Chapter Title}
%   \chapteropening{T}{he first sentence}
%   continues here.
%
% Three lines deep, with the rest of the opening phrase in
% small caps. Nothing is injected automatically — a chapter
% without \chapteropening just starts as ordinary text. Keep
% the opening paragraph long enough to clear the drop cap,
% or the next heading will collide with it.
% ============================================================
\RequirePackage{lettrine}

\newcommand{\chapteropening}[2]{%
  \lettrine[
    lines=3,
    loversize=0.0,
    lraise=0.0,
    findent=0.1em,
    nindent=0em
  ]{#1}{\textsc{#2}}%
}


% ============================================================
% TABLE OF CONTENTS
%
% No dot leaders and no framing rules: page numbers sit
% flush right and the title is set like a chapter. Call it
% with \booktoc.
% ============================================================
\RequirePackage{tocloft}

\renewcommand{\cfttoctitlefont}{\Huge\scshape}
\renewcommand{\cftaftertoctitle}{\par\vspace{2ex}}

\renewcommand{\cftchapleader}{\hfill}
\renewcommand{\cftsecleader}{\hfill}
\renewcommand{\cftsubsecleader}{\hfill}

\setlength{\cftchapnumwidth}{2.5em}
\setlength{\cftsecnumwidth}{3.0em}
\setlength{\cftsubsecnumwidth}{3.5em}

% Unnumbered sections otherwise start at tocloft's 1.5em —
% left of the chapter titles at 2.5em, so the children
% outdent past their parent. Line the sections up under the
% chapter title, and subsections one step further.
\setlength{\cftsecindent}{2.5em}
\setlength{\cftsubsecindent}{3.5em}

\setlength{\cftbeforechapskip}{6pt}
\setlength{\cftbeforesecskip}{2.5pt}
\setlength{\cftbeforesubsecskip}{1.5pt}

\newcommand{\booktoc}{%
  \tableofcontents
}


% ============================================================
% HEADERS & PAGE STYLES
%
% Page numbers sit on the outer edge, the running chapter or
% section mark in the centre. Chapter opening pages drop the
% header and take a centred folio instead. 'plain' is left
% alone, so the front matter is unaffected.
%
% Position codes in the definitions below:
%   L left, C centre, R right
%   E even page (verso), O odd page (recto)
% ============================================================
\RequirePackage{fancyhdr}
% 15pt rather than the class default: with Garamond Libre's
% ascenders at 12pt, fancyhdr asks for at least 14.5pt and
% warns below that. 15pt is the first whole point above.
\setlength{\headheight}{15pt}

\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% ------------------ Main matter pages -------------
\fancypagestyle{chapterstyle}{
  \fancyhf{}
  \fancyhead[LE]{\thepage}
  \fancyhead[CE]{\small\itshape\leftmark}
  \fancyhead[RO]{\thepage}
  \fancyhead[CO]{\small\itshape\rightmark}
}

% ------------------ Chapter opening pages --------
\fancypagestyle{chapteropen}{
  \fancyhf{}
  \fancyfoot[C]{\thepage}
}

% ------------------ Front matter pages ------------
\fancypagestyle{frontmatterstyle}{
  \fancyhf{}
  \fancyhead[LE]{\thepage}
  \fancyhead[CE]{\small\itshape\leftmark}
  \fancyhead[RO]{\thepage}
  \fancyhead[CO]{\small\itshape\rightmark}
}

\fancypagestyle{frontmatteropen}{
  \fancyhf{}
  \fancyfoot[C]{\thepage}
}


% ============================================================
% CHAPTER OPENING PAGE STYLE
%
% \chapter hard-codes \thispagestyle{plain} on its opening
% page. This patch redirects it to 'chapteropen' without
% touching 'plain' itself, which the front matter still uses.
% ============================================================
\RequirePackage{etoolbox}
\makeatletter

\patchcmd{\chapter}
  {\thispagestyle{plain}}
  {\thispagestyle{chapteropen}}
  {}{}

\makeatother


% ============================================================
% BLANK VERSO PAGES
%
% \cleardoublepage inserts a blank page to land on a recto,
% but the blank inherits the current page style and carries
% a running head and folio. The convention is that inserted
% blanks are completely empty. emptypage patches
% \cleardoublepage to do exactly that.
% ============================================================
\RequirePackage{emptypage}


% ============================================================
% FRONT-MATTER CHAPTERS
%
%   \frontchapter{Preface}
%
% An unnumbered, flush-left heading one step smaller than a
% main chapter, for the preface, acknowledgements and the
% like. It sets the running header itself, which is what
% keeps "Chapter 0" from appearing. Begin the first
% paragraph with \noindent.
% ============================================================
\makeatletter

\newcommand{\frontchapter}[1]{%
  \cleardoublepage
  \thispagestyle{frontmatteropen}

  % Set running header text (avoids "Chapter 0")
  \markboth{#1}{}

  % Heading block
  \vspace*{3ex}
  {\noindent\LARGE\bfseries #1\par}
  \vspace{3ex}
}

\makeatother


% ============================================================
% RUNNING HEADER TEXT
%
% Chapter title on the verso, section title on the recto,
% neither uppercased.
% ============================================================
\renewcommand{\chaptermark}[1]{\markboth{#1}{}}
\renewcommand{\sectionmark}[1]{\markright{#1}}

\pagestyle{chapterstyle}


% ============================================================
% TITLE PAGE
%
%   \title{...}  \author{...}  \date{...}
%   \subtitle{...}                 % optional
%   \booktitlepage
%
% Title in large small caps, an italic subtitle below it if
% one is set, author under that, date at the foot. Written
% out rather than built on \maketitle so every space is
% visible here.
% ============================================================
\makeatletter

\def\@subtitle{}
\newcommand{\subtitle}[1]{\gdef\@subtitle{#1}}

\newcommand{\booktitlepage}{%
  \begin{titlepage}
    \thispagestyle{empty}

    \vspace*{0.18\textheight}

    \begin{center}
      {\Huge\scshape \@title \par}

      \ifx\@subtitle\@empty\else
        \vspace{1.6em}
        {\Large\itshape \@subtitle \par}
      \fi

      \vspace{3em}
      {\large \@author \par}
    \end{center}

    \vfill

    \begin{center}
      {\normalsize\itshape \@date \par}
    \end{center}
  \end{titlepage}
}

\makeatother


% ============================================================
% DEDICATION PAGE
%
%   \dedicationpage{To my parents.}
%
% One short italic line, centred a quarter of the way down a
% recto page, followed by a blank verso.
% ============================================================
\newcommand{\dedicationpage}[1]{%
  \cleardoublepage
  \thispagestyle{empty}
  \vspace*{0.25\textheight}
  \begin{center}
    \itshape #1
  \end{center}
  \vfill
  \cleardoublepage
}


% ============================================================
% CITATIONS
%
%   \cite{key}            superscript ¹
%   \cite{a,b,c}          sorted and compressed, ¹⁻³
%   \bibliography{...}    in the back matter of main.tex
%
% The 'nomove' option keeps a citation exactly where you
% wrote it instead of shifting it past punctuation, so put
% it directly after the word it belongs to.
% ============================================================
\RequirePackage[superscript,nomove]{cite}

% Bibliography list labels: "1." instead of "[1]",
% to match the superscript style used in the text.
\makeatletter
\renewcommand{\@biblabel}[1]{#1.}
\makeatother


% ============================================================
% HYPERLINKS
%
% Loaded last, because hyperref patches commands that other
% packages define. Links are black rather than coloured, so
% the page prints exactly as it would without them while
% staying live in a PDF reader.
% ============================================================
\RequirePackage{xcolor}
\definecolor{linkblack}{RGB}{0,0,0}

\RequirePackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=linkblack,
  citecolor=linkblack,
  urlcolor=linkblack,
  linktoc=page
}

% hyperref colours table-of-contents page numbers by
% default; these three keep them black like everything else.
\makeatletter
\renewcommand{\cftchappagefont}{\normalfont\color{black}}
\renewcommand{\cftsecpagefont}{\normalfont\color{black}}
\renewcommand{\cftsubsecpagefont}{\normalfont\color{black}}
\makeatother


% ============================================================
% END OF FILE
% ============================================================
\endinput
